	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Always
		DO: DoAll
				SetState {NPC_TALK}
~~ }

STATE: {TURNIN_WAIT} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: ChatMatch {^Hea Rukenua the Zefir Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_zefir,1]}
	IF: ChatMatch {^Hea Tamarau the Ursuin Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_ursuin,1]}
	IF: ChatMatch {^Hea Koruani the Golem Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_golem,1]}
	IF: ChatMatch {^Hea Weneria the Gromnie Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_gromnie,1]}
	IF: ChatMatch {^Hea Taraneki the Siraluun Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_siraluun,1]}
	IF: ChatMatch {^Hea Kurelan the Carenzi Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_carenzi,1]}
	IF: ChatMatch {^Hea Ruatane the Virindi Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_virindi,1]}
	IF: ChatMatch {^Hea Varenkeh the Olthoi Hunter tells you, "You have served the Hea well\. Accept this reward for your efforts\."}
		DO: DoExpr {setvar[pt_unavailable_olthoi,1]}
	IF: Expr {getvar[pt_npc_end]==1 && getvar[pt_unavailable_zefir]==1 && getvar[pt_unavailable_ursuin]==1 && getvar[pt_unavailable_golem]==1 && getvar[pt_unavailable_gromnie]==1 && getvar[pt_unavailable_siraluun]==1 && getvar[pt_unavailable_carenzi]==1 && getvar[pt_unavailable_virindi]==1 && getvar[pt_unavailable_olthoi]==1}
		DO: DoAll
				DoExpr {echo[Plateau Treasure: all active hunt rewards confirmed.]}
				SetState {ERROR_HOLD}
	IF: Expr {getvar[pt_npc_end]==1}
		DO: DoAll
				DoExpr {echo[`Plateau Treasure: turn-in route finished. Check the NPC reward replies.`]}
				SetState {ERROR_HOLD}
	IF: SecsInStateGE 300
		DO: SetState {ROUTE_HOLD}
~~ }

