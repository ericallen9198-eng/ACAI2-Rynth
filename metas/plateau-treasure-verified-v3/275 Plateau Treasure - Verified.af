STATE: {TRAVEL_WAIT} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Expr {getvar[pt_travel_end]==1 && getvar[pt_region]==1}
		DO: DoAll
				Chat {/ra nav load 275 - Hunt East}
				SetState {REGION_START}
	IF: Expr {getvar[pt_travel_end]==1 && getvar[pt_region]==2}
		DO: DoAll
				Chat {/ra nav load 275 - Hunt Northeast}
				SetState {REGION_START}
	IF: Expr {getvar[pt_travel_end]==1 && getvar[pt_region]==3}
		DO: DoAll
				Chat {/ra nav load 275 - Hunt West}
				SetState {REGION_START}
	IF: SecsInStateGE 900
		DO: SetState {ROUTE_HOLD}
~~ }

STATE: {REGION_START} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Always
		DO: DoAll
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
				SetState {HUNT_RESUME}
~~ }

