STATE: {Default} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF:	Always
		DO:	DoAll
				DoExpr {if[getpvar[pt_cache_pickup_held]==1,rasetsetting[`LootChestsMacroOff`,getpvar[pt_cache_old_pickup]]]}
				DoExpr {setpvar[pt_cache_pickup_held,0]}
				Chat {/ub clearmotion}
				SetOpt {StopMacroOnDeath} {False}
				SetOpt {AutoCram} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {uboptset[`InventoryManager.AutoCram`,false]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_doubloon_before,0]}
				DoExpr {setvar[tm_map_gate_until,0]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_resume_needed,0]}
				DoExpr {setvar[tm_resume_pos,0]}
				DoExpr {setvar[tm_run_length,0]}
				DoExpr {setvar[tm_run_start,0]}
				DoExpr {setvar[tm_watch_pos,0]}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[pt_skipped,listcreate[]]}
				DoExpr {setvar[pt_refresh_at,0]}
				DoExpr {setvar[pt_done_zefir,0]}
				DoExpr {setvar[pt_done_ursuin,0]}
				DoExpr {setvar[pt_done_golem,0]}
				DoExpr {setvar[pt_done_gromnie,0]}
				DoExpr {setvar[pt_done_siraluun,0]}
				DoExpr {setvar[pt_done_carenzi,0]}
				DoExpr {setvar[pt_done_virindi,0]}
				DoExpr {setvar[pt_done_olthoi,0]}
				DoExpr {setvar[pt_unavailable_zefir,0]}
				DoExpr {setvar[pt_unavailable_ursuin,0]}
				DoExpr {setvar[pt_unavailable_golem,0]}
				DoExpr {setvar[pt_unavailable_gromnie,0]}
				DoExpr {setvar[pt_unavailable_siraluun,0]}
				DoExpr {setvar[pt_unavailable_carenzi,0]}
				DoExpr {setvar[pt_unavailable_virindi,0]}
				DoExpr {setvar[pt_unavailable_olthoi,0]}
				DoExpr {setvar[pt_region,0]}
				DoExpr {setvar[pt_turnin,0]}
				DoExpr {setvar[pt_recallwest,0]}
				DoExpr {setvar[pt_current_npc,``]}
				DoExpr {setvar[pt_npc_attempt,0]}
				DoExpr {setvar[pt_target_zefir,``]}
				DoExpr {setvar[pt_required_zefir,0]}
				DoExpr {setvar[pt_target_ursuin,``]}
				DoExpr {setvar[pt_required_ursuin,0]}
				DoExpr {setvar[pt_target_golem,``]}
				DoExpr {setvar[pt_required_golem,0]}
				DoExpr {setvar[pt_target_gromnie,``]}
				DoExpr {setvar[pt_required_gromnie,0]}
				DoExpr {setvar[pt_target_siraluun,``]}
				DoExpr {setvar[pt_required_siraluun,0]}
				DoExpr {setvar[pt_target_carenzi,``]}
				DoExpr {setvar[pt_required_carenzi,0]}
				DoExpr {setvar[pt_target_virindi,``]}
				DoExpr {setvar[pt_required_virindi,0]}
				DoExpr {setvar[pt_target_olthoi,``]}
				DoExpr {setvar[pt_required_olthoi,0]}
				DoExpr {setvar[tm_cache_id,0]}
				DoExpr {setvar[tm_cache_pending,0]}
				DoExpr {setvar[tm_cache_pending_template,0]}
				DoExpr {setvar[tm_cache_pending_amount,0]}
				DoExpr {setvar[tm_cache_before_count,0]}
				DoExpr {setvar[tm_cache_pickups,0]}
				DoExpr {setvar[tm_cache_stackmode,1]}
				DoExpr {setvar[tm_cache_sent,0]}
				DoExpr {setvar[tm_cache_pickup_retry_at,0]}
				SetOpt {DeathRecallMode} {0}
				SetOpt {TravelToOwnCorpse} {False}
				SetOpt {KeepHuntingAfterDeath} {False}
				DoExpr {setvar[pt_death_return,0]}
				DoExpr {setvar[pt_death_region,0]}
				SetState {START_LOCATION}
~~ }

STATE: {START_LOCATION} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: All
			Expr {getplayerlandcell[]==565641256}
			Expr {!isportaling[]}
		DO: SetState {NPC_TALK}
	IF: Always
		DO: SetState {GET_TO}
~~ }

STATE: {GET_TO} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				Chat {/ls}
				SetState {LIFESTONE_WAIT}
~~ }

STATE: {GET_TO_WAIT} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Expr {getcharvital_current[1]>0 && getcharvital_buffedmax[1]>0 && !isportaling[] && getplayerlandcell[]==565641256}
		DO: DoAll
				SetState {CAMP_SETTLE}
	IF: ChatMatch {(?i)^Using the Plateau Hunters' Camp}
		DO: SetState {CAMP_PORTAL_WAIT}
	IF: SecsInStateGE 160
		DO: SetState {ROUTE_HOLD}
~~ }

STATE: {CAMP_PORTAL_WAIT} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Expr {getcharvital_current[1]>0 && getcharvital_buffedmax[1]>0 && !isportaling[] && getplayerlandcell[]==565641256}
		DO: DoAll
				SetState {CAMP_SETTLE}
	IF: ExitPortal
		DO: SetState {CAMP_SETTLE}
	IF: SecsInStateGE 60
		DO: SetState {ROUTE_HOLD}
~~ }

STATE: {CAMP_SETTLE} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: All
			SecsInStateGE 5
			Expr {getvar[pt_death_return]==1}
		DO: DoAll
				SetState {RECOVER_DISPATCH}
	IF: All
			SecsInStateGE 5
			Expr {getvar[pt_turnin]==1}
		DO: SetState {TURNIN_TALK}
	IF: All
			SecsInStateGE 5
			Expr {getvar[pt_recallwest]==1}
		DO: SetState {LANDING_WEST}
	IF: SecsInStateGE 5
		DO: SetState {NPC_TALK}
~~ }

STATE: {NPC_TALK} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Always
		DO: DoAll
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[pt_npc_end,0]}
				SetState {VERIFY_ZEFIR}
~~ }

STATE: {NPC_TALK_WAIT} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Always
		DO: DoAll
				SetState {VERIFY_ZEFIR}
~~ }

STATE: {HUNT_INIT} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Expr {getvar[pt_done_golem]==1 && getvar[pt_done_siraluun]==1 && getvar[pt_done_virindi]==1 && getvar[pt_done_olthoi]==1 && getvar[pt_done_gromnie]==1 && getvar[pt_done_zefir]==1 && getvar[pt_done_ursuin]==1 && getvar[pt_done_carenzi]==1}
		DO: SetState {CAMP_EAST}
	IF: Expr {getvar[pt_region]==0 && (getvar[pt_done_golem]==0 || getvar[pt_done_siraluun]==0 || getvar[pt_done_virindi]==0)}
		DO: SetState {CAMP_EAST}
	IF: Expr {getvar[pt_region]==0 && getvar[pt_done_olthoi]==0}
		DO: SetState {CAMP_NORTHEAST}
	IF: Expr {getvar[pt_region]==0}
		DO: SetState {CAMP_WEST}
	IF: Expr {getvar[pt_region]==1 && getvar[pt_done_olthoi]==0}
		DO: SetState {EAST_NORTHEAST}
	IF: Expr {getvar[pt_region]==1}
		DO: SetState {RECALL_WEST}
	IF: Expr {getvar[pt_region]==2}
		DO: SetState {RECALL_WEST}
	IF: Always
		DO: SetState {ROUTE_HOLD}
~~ }

