STATE: {MAP_CLUE} ~~ {
	IF:	Death
		DO:	SetState {DEATH_RECOVER}
	IF:	ChatMatch {You dig at the site\. \(1/3\)}
		DO:	SetState {DIG_FIRST}
	IF:	ChatMatch {You dig at the site\. \(2/3\)}
		DO:	SetState {DIG_SECOND}
	IF:	ChatMatch {(?i)(The earth splits|The ground splits wide|The dig collapses inward|The dig breaks into something hollow|\[Digsite\] (Boss at|Wave |Corrupted))}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	ChatMatch {(?i)lies far off to the north\.}
		DO:	SetState {FAR_NORTH}
	IF:	ChatMatch {(?i)lies far off to the northeast\.}
		DO:	SetState {FAR_NORTHEAST}
	IF:	ChatMatch {(?i)lies far off to the east\.}
		DO:	SetState {FAR_EAST}
	IF:	ChatMatch {(?i)lies far off to the southeast\.}
		DO:	SetState {FAR_SOUTHEAST}
	IF:	ChatMatch {(?i)lies far off to the south\.}
		DO:	SetState {FAR_SOUTH}
	IF:	ChatMatch {(?i)lies far off to the southwest\.}
		DO:	SetState {FAR_SOUTHWEST}
	IF:	ChatMatch {(?i)lies far off to the west\.}
		DO:	SetState {FAR_WEST}
	IF:	ChatMatch {(?i)lies far off to the northwest\.}
		DO:	SetState {FAR_NORTHWEST}
	IF:	ChatMatch {(?i)is to the north\. You are getting close\.}
		DO:	SetState {CLOSE_NORTH}
	IF:	ChatMatch {(?i)is to the northeast\. You are getting close\.}
		DO:	SetState {CLOSE_NORTHEAST}
	IF:	ChatMatch {(?i)is to the east\. You are getting close\.}
		DO:	SetState {CLOSE_EAST}
	IF:	ChatMatch {(?i)is to the southeast\. You are getting close\.}
		DO:	SetState {CLOSE_SOUTHEAST}
	IF:	ChatMatch {(?i)is to the south\. You are getting close\.}
		DO:	SetState {CLOSE_SOUTH}
	IF:	ChatMatch {(?i)is to the southwest\. You are getting close\.}
		DO:	SetState {CLOSE_SOUTHWEST}
	IF:	ChatMatch {(?i)is to the west\. You are getting close\.}
		DO:	SetState {CLOSE_WEST}
	IF:	ChatMatch {(?i)is to the northwest\. You are getting close\.}
		DO:	SetState {CLOSE_NORTHWEST}
	IF:	Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
