		DO: DoAll
				DoExpr {setvar[tm_map_id,wobjectgetid[listgetitem[listfilter[wobjectfindallinventorybytemplatetype[1004100],isfalse[listcontains[getvar[pt_skipped],wobjectgetid[$1]]]],0]]]}
