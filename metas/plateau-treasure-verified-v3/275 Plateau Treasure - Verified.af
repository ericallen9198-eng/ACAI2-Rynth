STATE: {ENCOUNTER} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_zefir] && (getvar[capturegroup_killed]==getvar[pt_target_zefir] || getvar[capturegroup_killed]==getvar[pt_target_zefir]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_zefir,1]}
				DoExpr {echo[`Plateau Treasure: zefir task complete; continuing treasure hunting.`]}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_ursuin] && (getvar[capturegroup_killed]==getvar[pt_target_ursuin] || getvar[capturegroup_killed]==getvar[pt_target_ursuin]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_ursuin,1]}
				DoExpr {echo[`Plateau Treasure: ursuin task complete; continuing treasure hunting.`]}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_golem] && (getvar[capturegroup_killed]==getvar[pt_target_golem] || getvar[capturegroup_killed]==getvar[pt_target_golem]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_golem,1]}
				DoExpr {echo[`Plateau Treasure: golem task complete; continuing treasure hunting.`]}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_gromnie] && (getvar[capturegroup_killed]==getvar[pt_target_gromnie] || getvar[capturegroup_killed]==getvar[pt_target_gromnie]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_gromnie,1]}
				DoExpr {echo[`Plateau Treasure: gromnie task complete; continuing treasure hunting.`]}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_siraluun] && (getvar[capturegroup_killed]==getvar[pt_target_siraluun] || getvar[capturegroup_killed]==getvar[pt_target_siraluun]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_siraluun,1]}
				DoExpr {echo[`Plateau Treasure: siraluun task complete; continuing treasure hunting.`]}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_carenzi] && (getvar[capturegroup_killed]==getvar[pt_target_carenzi] || getvar[capturegroup_killed]==getvar[pt_target_carenzi]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_carenzi,1]}
				DoExpr {echo[`Plateau Treasure: carenzi task complete; continuing treasure hunting.`]}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_virindi] && (getvar[capturegroup_killed]==getvar[pt_target_virindi] || getvar[capturegroup_killed]==getvar[pt_target_virindi]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_virindi,1]}
				DoExpr {echo[`Plateau Treasure: virindi task complete; continuing treasure hunting.`]}
	IF: All
			ChatCapture {^You have killed (?<kills>\d+) (?<killed>[^!]+)! Your task is complete!$} {}
			Expr {getvar[capturegroup_kills]==getvar[pt_required_olthoi] && (getvar[capturegroup_killed]==getvar[pt_target_olthoi] || getvar[capturegroup_killed]==getvar[pt_target_olthoi]+`s`)}
		DO: DoAll
				DoExpr {setvar[pt_done_olthoi,1]}
				DoExpr {echo[`Plateau Treasure: olthoi task complete; continuing treasure hunting.`]}
	IF:	Expr {getvar[tm_aun_loot_active]==0 && listcount[wobjectfindalllandscapebynamerx[`(?i)Corpse of .*Aun Relaria.*`]]>0}
		DO:	DoAll
				SetOpt {EnableLooting} {True}
				DoExpr {setvar[tm_aun_loot_active,1]}
	IF:	Expr {getvar[tm_aun_loot_active]==1 && listcount[wobjectfindalllandscapebynamerx[`(?i)Corpse of .*Aun Relaria.*`]]==0}
		DO:	DoAll
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
	IF:	Expr {getpvar[tm_dig_active]==1 && getinventorycountbytemplatetype[1004101]>getvar[tm_doubloon_before]}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_success_encounter,getpvar[tm_stat_success_encounter]+1]}
				DoExpr {echo[`Treasure Hunter: +`+(getinventorycountbytemplatetype[1004101]-getvar[tm_doubloon_before])+` Marae Lassel Doubloons (corpse)`]}
				SetState {CACHE_FINISH}
	IF:	ChatMatch {(?i)(Something buried at the dig gives way|smaller cache settles into the loose earth|The last of them falls\. Wave 8 is cleared|The last of the corruption is put down)}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_completion,getpvar[tm_stat_completion]+1]}
				DoExpr {setpvar[tm_stat_cache_search,getpvar[tm_stat_cache_search]+1]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_cache_deadline,getunixtime[]+300]}
				SetState {CACHE_PREP}
	IF: All
			ChatMatch {(?i)You've earned [0-9,]+ experience}
			Expr {listcount[wobjectfindalllandscapebynamerx[`^Unearthed Cache$`]]>0}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_completion,getpvar[tm_stat_completion]+1]}
				DoExpr {setpvar[tm_stat_cache_search,getpvar[tm_stat_cache_search]+1]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_cache_deadline,getunixtime[]+300]}
				SetState {CACHE_PREP}
	IF:	SecsInStateGE 1800
		DO:	DoAll
				DoExpr {setpvar[tm_stat_timeout_encounter,getpvar[tm_stat_timeout_encounter]+1]}
				SetState {ENCOUNTER_TIMEOUT}
~~ }

STATE: {CACHE_SEARCH} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: DoAll
				DoExpr {echo[`Plateau Treasure: cache collection timed out; currency pickup is not confirmed. Holding for review.`]}
				SetState {ERROR_HOLD}
	IF: Expr {wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]==0}
		DO: DoAll
				DoExpr {setvar[tm_cache_id,wobjectgetid[wobjectgetopencontainer[]]]}
				SetState {CACHE_SEARCH}
	IF: Expr {wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]!=0 && wobjectgetid[wobjectgetopencontainer[]]==getvar[tm_cache_id] && listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`]]>0 && getunixtime[]>=getvar[tm_cache_pickup_retry_at]}
		DO: DoAll
				DoExpr {setvar[tm_cache_pending,wobjectgetid[listgetitem[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`],0]]]}
				DoExpr {setvar[tm_cache_pending_template,wobjectgetintprop[wobjectfindbyid[getvar[tm_cache_pending]],218103808]]}
				DoExpr {setvar[tm_cache_pending_amount,max[1,wobjectgetintprop[wobjectfindbyid[getvar[tm_cache_pending]],12]]]}
				DoExpr {setvar[tm_cache_before_count,getinventorycountbytemplatetype[getvar[tm_cache_pending_template]]]}
				SetState {CACHE_PICKUP}
	IF: Expr {wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]!=0 && wobjectgetid[wobjectgetopencontainer[]]==getvar[tm_cache_id] && listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`]]==0 && getvar[tm_cache_pickups]>0}
		DO: DoAll
				SetState {CACHE_SETTLE}
	IF: All
			SecsInStateGE 5
			Expr {getunixtime[]>=getvar[tm_cache_retry_at] && !(wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache`)}
		DO: DoAll
				DoExpr {setvar[tm_cache_retry_at,getunixtime[]+8]}
				DoExpr {if[getvar[tm_cache_id]==0,chatbox[`/ub use Unearthed Cache`]]}
				DoExpr {if[getvar[tm_cache_id]!=0,actiontryuseitem[wobjectfindbyid[getvar[tm_cache_id]]]]}
				SetState {CACHE_SEARCH}
~~ }

STATE: {CACHE_FINISH} ~~ {
	IF:	Death
		DO:	SetState {DEATH_RECOVER}
	IF:	Always
		DO:	DoAll
				DoExpr {if[getpvar[pt_cache_pickup_held]==1,rasetsetting[`LootChestsMacroOff`,getpvar[pt_cache_old_pickup]]]}
				DoExpr {setpvar[pt_cache_pickup_held,0]}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_doubloon_before,0]}
				SetState {HUNT_RESUME}
~~ }

