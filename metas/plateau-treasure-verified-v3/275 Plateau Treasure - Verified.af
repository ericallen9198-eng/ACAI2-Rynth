STATE: {VERIFY_ZEFIR_WAIT} ~~ {
	IF: Death
		DO: SetState {DEATH_RECOVER}
	IF: ChatCapture {^Hea\ Rukenua\ the\ Zefir\ Hunter tells you, "Slay (?<total>\d+) (?<target>[^".]+)\. Return when the work is done\."$} {}
		DO: DoAll
				SetOpt {EnableNav} {False}
				DoExpr {setvar[pt_pickup_zefir,1]}
				DoExpr {setvar[pt_done_zefir,0]}
				DoExpr {setvar[pt_unavailable_zefir,0]}
				DoExpr {setvar[pt_target_zefir,getvar[capturegroup_target]]}
				DoExpr {setvar[pt_required_zefir,getvar[capturegroup_total]]}
				DoExpr {echo[`Plateau Treasure: confirmed zefir task: `+getvar[capturegroup_target]+` / `+getvar[capturegroup_total]+`.`]}
				SetState {VERIFY_URSUIN}
	IF: ChatCapture {^Hea\ Rukenua\ the\ Zefir\ Hunter tells you, "You have defeated (?<progress>\d+) of (?<total>\d+) (?<target>[^".]+)\.[^"]*"$} {}
		DO: DoAll
				SetOpt {EnableNav} {False}
				DoExpr {setvar[pt_pickup_zefir,1]}
				DoExpr {setvar[pt_done_zefir,0]}
				DoExpr {setvar[pt_unavailable_zefir,0]}
				DoExpr {setvar[pt_target_zefir,getvar[capturegroup_target]]}
				DoExpr {setvar[pt_required_zefir,getvar[capturegroup_total]]}
				DoExpr {echo[`Plateau Treasure: confirmed zefir task: `+getvar[capturegroup_target]+` / `+getvar[capturegroup_total]+`.`]}
				SetState {VERIFY_URSUIN}
	IF: ChatMatch {^Hea\ Rukenua\ the\ Zefir\ Hunter tells you, "(?:Your hunt for today is done\.[^"]*|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"$}
		DO: DoAll
				SetOpt {EnableNav} {False}
				DoExpr {setvar[pt_pickup_zefir,1]}
				DoExpr {setvar[pt_done_zefir,1]}
				DoExpr {setvar[pt_unavailable_zefir,1]}
				DoExpr {echo[`Plateau Treasure: zefir acknowledged (cooldown/reward); treasure hunting remains enabled.`]}
				SetState {VERIFY_URSUIN}
	IF: SecsInStateGE 20
		DO: DoAll
				SetState {VERIFY_ZEFIR_RETRY}
~~ }

