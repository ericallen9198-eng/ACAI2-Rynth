	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[mh_tm_stat_dig3_attempt,getpvar[mh_tm_stat_dig3_attempt]+1]}
				DoExpr {actiontryuseitem[wobjectfindbyid[getvar[tm_map_id]]]}
				SetState {DIG_3_RESPONSE}
~~ }

STATE: {DIG_3_RESPONSE} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	ChatMatch {(?i)(The earth splits|The ground splits wide|The dig collapses inward|The dig breaks into something hollow|\[Digsite\] (Boss at|Wave |Corrupted))}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	SecsInStateGE 15
		DO:	SetState {DIG_UNCERTAIN}
~~ }

STATE: {DIG_UNCERTAIN} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[mh_tm_dig_active,0]}
				SetState {TEMP_HUNT}
~~ }

STATE: {ENCOUNTER_INIT} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Always
		DO:	DoAll
				DoExpr {setvar[tm_cache_anchor,getplayercoordinates[]]}
				DoExpr {setvar[tm_event_deadline,getunixtime[]+1800]}
				DoExpr {setvar[tm_anchor_forced,0]}
				DoExpr {setvar[tm_anchor_retry_at,0]}
				DoExpr {setvar[tm_anchor_failures,0]}
				DoExpr {setpvar[mh_tm_stat_encounter,getpvar[mh_tm_stat_encounter]+1]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_aun_loot_active,0]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				DoExpr {setcombatstate[magic]}
				SetOpt {EnableLooting} {False}

				SetState {ENCOUNTER}
~~ }

STATE: {ENCOUNTER} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Expr {getvar[tm_aun_loot_active]==0 && listcount[wobjectfindalllandscapebynamerx[`(?i)Corpse of .*Aun Relaria.*`]]>0}
		DO:	DoAll
				SetOpt {EnableLooting} {True}
				DoExpr {setvar[tm_aun_loot_active,1]}
	IF:	Expr {getvar[tm_aun_loot_active]==1 && listcount[wobjectfindalllandscapebynamerx[`(?i)Corpse of .*Aun Relaria.*`]]==0}
		DO:	DoAll
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
	IF:	Expr {getpvar[mh_tm_dig_active]==1 && getinventorycountbytemplatetype[1004101]>getvar[tm_doubloon_before]}
		DO:	DoAll
				DoExpr {setpvar[mh_tm_stat_success_encounter,getpvar[mh_tm_stat_success_encounter]+1]}
				DoExpr {echo[`MapHunt: +`+(getinventorycountbytemplatetype[1004101]-getvar[tm_doubloon_before])+` Marae Lassel Doubloons (corpse)`]}
				SetState {CACHE_FINISH}
	IF:	ChatMatch {(?i)(Something buried at the dig gives way|smaller cache settles into the loose earth|The last of them falls\. Wave 8 is cleared|The last of the corruption is put down)}
		DO:	DoAll
				DoExpr {setpvar[mh_tm_stat_completion,getpvar[mh_tm_stat_completion]+1]}
				DoExpr {setpvar[mh_tm_stat_cache_search,getpvar[mh_tm_stat_cache_search]+1]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_cache_deadline,getunixtime[]+300]}
				SetState {CACHE_PREP}
	IF:	Expr {getvar[tm_event_deadline]>0 && getunixtime[]>=getvar[tm_event_deadline]}
		DO:	DoAll
				DoExpr {setpvar[mh_tm_stat_timeout_encounter,getpvar[mh_tm_stat_timeout_encounter]+1]}
				SetState {ENCOUNTER_TIMEOUT}
	IF: Expr {getpvar[mh_tm_dig_active]==1 && getvar[tm_cache_anchor]!=0 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_cache_anchor]]>=55 && getcharvital_current[1]>0 && maraerecoverybusy[]==0}
		DO: SetState {DIGSITE_FORCE_RETURN}
	IF: Expr {getpvar[mh_tm_dig_active]==1 && getvar[tm_cache_anchor]!=0 && strlen[getvar[tm_cache_anchor]]>0 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_cache_anchor]]>10 && ratargetcount[]==0 && getbusystate[]==0 && getvar[tm_aun_loot_active]!=1 && maraerecoverybusy[]==0 && getunixtime[]>=getvar[tm_anchor_retry_at]}
		DO: DoAll
				DoExpr {setvar[tm_anchor_forced,0]}
				SetState {DIGSITE_RETURN}
~~ }

STATE: {CACHE_SEARCH} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: DoAll
				DoExpr {echo[`MapHunt: cache collection timed out; resuming hunting with a map backoff.`]}
				SetState {MISSION_ERROR}
	IF: Expr {getpvar[mh_tm_dig_active]==1 && getvar[tm_cache_id]==0 && getvar[tm_cache_pending]==0 && getinventorycountbytemplatetype[1004101]>getvar[tm_doubloon_before]}
		DO: SetState {CACHE_FINISH}
	IF: Expr {getvar[tm_cache_id]!=0 && getvar[tm_cache_pending]==0 && getvar[tm_cache_pickups]==0 && getunixtime[]>=getvar[tm_cache_bound_at]+8 && (getvar[tm_cache_probe_id]==0 || getunixtime[]>=getvar[tm_cache_probe_until]) && (wobjectgetid[wobjectgetopencontainer[]]!=getvar[tm_cache_id] || listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]],`wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`]]==0)}
		DO: SetState {CACHE_RELEASE_EMPTY}
	IF: Expr {wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]==0 && listcontains[getvar[tm_cache_rejected],wobjectgetid[wobjectgetopencontainer[]]]==0}
		DO: DoAll
				DoExpr {setvar[tm_cache_id,wobjectgetid[wobjectgetopencontainer[]]]}
				DoExpr {setvar[tm_cache_bound_at,getunixtime[]]}
				DoExpr {setvar[tm_cache_probe_id,0]}
				SetState {CACHE_SEARCH}
	IF: Expr {wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]!=0 && wobjectgetid[wobjectgetopencontainer[]]==getvar[tm_cache_id] && listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`]]>0 && getunixtime[]>=getvar[tm_cache_pickup_retry_at]}
		DO: DoAll
				DoExpr {setvar[tm_cache_pending,wobjectgetid[listgetitem[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`],0]]]}
				DoExpr {setvar[tm_cache_pending_template,wobjectgetintprop[wobjectfindbyid[getvar[tm_cache_pending]],218103808]]}
				DoExpr {setvar[tm_cache_pending_amount,iif[wobjectgetintprop[wobjectfindbyid[getvar[tm_cache_pending]],12]>1,wobjectgetintprop[wobjectfindbyid[getvar[tm_cache_pending]],12],1]]}
				DoExpr {setvar[tm_cache_before_count,getinventorycountbytemplatetype[getvar[tm_cache_pending_template]]]}
				SetState {CACHE_PICKUP}
	IF: Expr {wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]!=0 && wobjectgetid[wobjectgetopencontainer[]]==getvar[tm_cache_id] && listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`]]==0 && getvar[tm_cache_pickups]>0}
		DO: DoAll
				SetState {CACHE_SETTLE}
	IF: Expr {getvar[tm_cache_probe_id]!=0 && getunixtime[]>=getvar[tm_cache_probe_until]}
		DO: DoAll
				DoExpr {setvar[tm_cache_probe_id,0]}
				SetState {CACHE_SEARCH}
	IF: Expr {getvar[tm_cache_id]!=0 && wobjectgetid[wobjectgetopencontainer[]]!=getvar[tm_cache_id] && getvar[tm_cache_probe_id]==0}
		DO: SetState {CACHE_REOPEN_BOUND}
	IF: All
			SecsInStateGE 2
			Expr {getvar[tm_cache_id]==0 && getvar[tm_cache_probe_id]==0 && getunixtime[]>=getvar[tm_cache_retry_at]}
		DO: SetState {CACHE_SCAN}
~~ }

STATE: {CACHE_FINISH} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Always
		DO:	DoAll
				DoExpr {if[getpvar[mh_pt_cache_pickup_held]==1,rasetsetting[`LootChestsMacroOff`,getpvar[mh_pt_cache_old_pickup]]]}
				DoExpr {setpvar[mh_pt_cache_pickup_held,0]}
				DoExpr {maraenavrestore[]}
				DoExpr {setpvar[mh_tm_dig_active,0]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_cache_probe_id,0]}
				DoExpr {setvar[tm_cache_anchor,0]}
				DoExpr {setvar[tm_cache_preexisting,listcreate[]]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_doubloon_before,0]}
				SetState {MAP_RETURN}
~~ }

STATE: {ENCOUNTER_TIMEOUT} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Always
		DO: DoAll
				SetState {MISSION_ERROR}

~~ }

STATE: {MAP_MISSING} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	ChatMatch {(?i)(The earth splits|The ground splits wide|The dig collapses inward|The dig breaks into something hollow|\[Digsite\])}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	SecsInStateGE 12
		DO:	DoAll
				DoExpr {setpvar[mh_tm_stat_map_missing,getpvar[mh_tm_stat_map_missing]+1]}
				DoExpr {setpvar[mh_tm_dig_active,0]}
				DoExpr {setvar[tm_map_id,0]}
				SetState {MAP_RETURN}
~~ }
STATE: {CACHE_PREP} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Always
		DO: DoAll
				DoExpr {if[getpvar[mh_pt_cache_pickup_held]==1,rasetsetting[`LootChestsMacroOff`,getpvar[mh_pt_cache_old_pickup]]]}
				DoExpr {setpvar[mh_pt_cache_pickup_held,0]}
				DoExpr {setpvar[mh_pt_cache_old_pickup,ragetsetting[`LootChestsMacroOff`]]}
				DoExpr {setpvar[mh_pt_cache_pickup_held,1]}
				DoExpr {rasetsetting[`LootChestsMacroOff`,0]}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				DoExpr {setvar[tm_cache_id,0]}
				DoExpr {if[getvar[tm_cache_anchor]==0,setvar[tm_cache_anchor,getplayercoordinates[]]]}
				DoExpr {setvar[tm_cache_tried,listcreate[]]}
				DoExpr {setvar[tm_cache_rejected,listcreate[]]}
				DoExpr {setvar[tm_cache_probe_id,0]}
				DoExpr {setvar[tm_cache_probe_until,0]}
				DoExpr {setvar[tm_cache_candidates,listcreate[]]}
				DoExpr {setvar[tm_cache_sent,0]}
				DoExpr {setvar[tm_cache_pending,0]}
				DoExpr {setvar[tm_cache_pickup_retry_at,0]}
				DoExpr {setvar[tm_cache_pickups,0]}
				DoExpr {setvar[tm_cache_stackmode,1]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_walk_generation,0]}
				DoExpr {setvar[tm_walk_ack,0]}
				SetState {CACHE_RETURN_CHECK}
~~ }

STATE: {CACHE_PICKUP} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getvar[tm_cache_pending_template]<=0 || getvar[tm_cache_pending]<=0}
		DO: DoAll
				DoExpr {echo[`MapHunt: missing cache item identity; holding without moving it.`]}
				SetState {MISSION_ERROR}
	IF: Expr {wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]!=0 && wobjectgetid[wobjectgetopencontainer[]]==getvar[tm_cache_id] && listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetid[$1]==getvar[tm_cache_pending]`]]>0}
		DO: DoAll
				DoExpr {setvar[mh_status,`Collecting currency from the opened cache`]}
				DoExpr {setpvar[mh_mm_pickup_unresolved,1]}
				DoExpr {setpvar[mh_mm_pickup_item,getvar[tm_cache_pending]]}
				DoExpr {setpvar[mh_mm_pickup_container,getvar[tm_cache_id]]}
				DoExpr {setvar[tm_cache_sent,maraecachepickup[wobjectfindbyid[getvar[tm_cache_pending]]]]}
				SetState {CACHE_CONFIRM}
	IF: Always
		DO: DoAll
				SetState {CACHE_SEARCH}
~~ }

STATE: {CACHE_CONFIRM} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getvar[tm_cache_sent]==1 && getinventorycountbytemplatetype[getvar[tm_cache_pending_template]]>getvar[tm_cache_before_count] && (listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetid[$1]==getvar[tm_cache_pending]`]]==0 || wobjectgetintprop[wobjectfindbyid[getvar[tm_cache_pending]],12]<getvar[tm_cache_pending_amount])}
		DO: DoAll
				DoExpr {setvar[tm_cache_pickups,getvar[tm_cache_pickups]+1]}
				DoExpr {setvar[tm_cache_stackmode,iif[listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetid[$1]==getvar[tm_cache_pending]`]]>0,0,1]]}
				DoExpr {setpvar[mh_mm_pickup_unresolved,0]}
				DoExpr {setvar[tm_cache_sent,0]}
				DoExpr {setvar[tm_cache_pending,0]}
				DoExpr {setvar[tm_cache_pickup_retry_at,getunixtime[]+2]}
				SetState {CACHE_SEARCH}
	IF: All
			SecsInStateGE 2
			Expr {getvar[tm_cache_sent]==0}
		DO: DoAll
				DoExpr {setpvar[mh_mm_pickup_unresolved,0]}
				DoExpr {setvar[tm_cache_sent,0]}
				DoExpr {setvar[tm_cache_pending,0]}
				DoExpr {setvar[tm_cache_pickup_retry_at,getunixtime[]+2]}
				SetState {CACHE_SEARCH}
	IF: SecsInStateGE 20
		DO: DoAll
				DoExpr {echo[`MapHunt: currency move was sent but not confirmed. Check pack space and the open cache. Holding; no blind resend.`]}
				SetState {MISSION_ERROR}
~~ }

STATE: {CACHE_SETTLE} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {(wobjectgetname[wobjectgetopencontainer[]]==`Unearthed Cache` && getvar[tm_cache_id]!=0 && wobjectgetid[wobjectgetopencontainer[]]==getvar[tm_cache_id])==0 || listcount[listfilter[wobjectfindallbycontainer[wobjectgetopencontainer[]], `wobjectgetintprop[$1,218103808]==1004101 || wobjectgetobjectclass[$1]==15`]]>0}
		DO: DoAll
				SetState {CACHE_SEARCH}
	IF: SecsInStateGE 2
		DO: DoAll
				DoExpr {setpvar[mh_tm_stat_success_search,getpvar[mh_tm_stat_success_search]+1]}
				DoExpr {echo[`MapHunt: cache currency collected and confirmed.`]}
				SetState {CACHE_FINISH}
~~ }

STATE: {MISSION_ERROR} ~~ {
	IF: Expr {getpvar[mh_mm_pickup_unresolved]==1}
		DO: SetState {INVENTORY_REVIEW}
	IF: Always
		DO: DoAll
				SetState {RECOVERY_CLEANUP}

~~ }

STATE: {CACHE_RELEASE_EMPTY} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Always
		DO: DoAll
				DoExpr {listadd[getvar[tm_cache_tried],getvar[tm_cache_id]]}
				DoExpr {listadd[getvar[tm_cache_rejected],getvar[tm_cache_id]]}
				DoExpr {setvar[tm_cache_id,0]}
				DoExpr {setvar[tm_cache_probe_id,0]}
				DoExpr {setvar[mh_status,`Cache yielded no currency; trying another local cache`]}
				SetState {CACHE_SCAN}
~~ }

STATE: {CACHE_SCAN} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Always
		DO: DoAll
				DoExpr {setvar[tm_cache_candidates,listfilter[wobjectfindalllandscapebynamerx[`^Unearthed Cache$`],`listcontains[getvar[tm_cache_tried],wobjectgetid[$1]]==0 && listcontains[getvar[tm_cache_rejected],wobjectgetid[$1]]==0`]]}
				SetState {CACHE_CHOOSE}
~~ }

STATE: {CACHE_CHOOSE} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Expr {listcount[getvar[tm_cache_candidates]]>0}
		DO: SetState {CACHE_TRY_NEXT}
	IF: Always
		DO: DoAll
				DoExpr {setvar[tm_cache_tried,listcreate[]]}
				DoExpr {setvar[tm_cache_rejected,listcreate[]]}
				DoExpr {setvar[tm_cache_retry_at,getunixtime[]+8]}
				DoExpr {setvar[mh_status,`No unopened cache confirmed; refreshing local cache IDs`]}
				SetState {CACHE_SEARCH}
~~ }

STATE: {CACHE_TRY_NEXT} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Always
		DO: DoAll
				DoExpr {setvar[tm_cache_probe_id,wobjectgetid[listgetitem[getvar[tm_cache_candidates],0]]]}
				DoExpr {listadd[getvar[tm_cache_tried],getvar[tm_cache_probe_id]]}
				SetState {CACHE_APPROACH_CHECK}
~~ }

STATE: {CACHE_REOPEN_BOUND} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
