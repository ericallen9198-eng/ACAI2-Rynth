				DoExpr {setvar[tm_walk_target,wobjectgetphysicscoordinates[wobjectfindbyid[getvar[tm_cache_probe_id]]]]}
				DoExpr {setvar[tm_walk_generation,getvar[tm_walk_generation]+1]}
				DoExpr {setvar[mh_walk_token,getvar[mh_walk_token]+1]}
				DoExpr {setvar[tm_walk_ack,0]}
