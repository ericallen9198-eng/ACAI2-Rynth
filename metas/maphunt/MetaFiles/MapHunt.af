				SetState {CACHE_APPROACH_CHECK}
~~ }

STATE: {CACHE_RETURN_CHECK} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Expr {getvar[tm_cache_anchor]!=0 && strlen[getvar[tm_cache_anchor]]>0 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_cache_anchor]]>3}
		DO: SetState {CACHE_RETURN}
	IF: Always
		DO: DoAll
				SetState {CACHE_SEARCH}
~~ }

STATE: {CACHE_RETURN} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Always
		DO: DoAll
				DoExpr {setvar[tm_walk_target,getvar[tm_cache_anchor]]}
				DoExpr {setvar[tm_walk_generation,getvar[tm_walk_generation]+1]}
				DoExpr {setvar[mh_walk_token,getvar[mh_walk_token]+1]}
				DoExpr {setvar[tm_walk_ack,0]}
				DoExpr {setvar[mh_status,`Returning to the recorded digsite`]}
				SetState {CACHE_RETURN_WAIT}
~~ }

STATE: {CACHE_RETURN_WAIT} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Expr {getvar[tm_walk_ack]==1 && strlen[getplayercoordinates[]]>0 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_walk_target]]<=2}
		DO: DoAll
