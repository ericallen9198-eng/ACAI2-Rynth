				SetOpt {EnableNav} {False}
				Chat {/ub clearmotion}
				SetState {CACHE_SEARCH}
~~ }

STATE: {CACHE_APPROACH_CHECK} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO: SetState {MISSION_ERROR}
	IF: Expr {strlen[wobjectgetphysicscoordinates[wobjectfindbyid[getvar[tm_cache_probe_id]]]]>0 && coordinatedistanceflat[getplayercoordinates[],wobjectgetphysicscoordinates[wobjectfindbyid[getvar[tm_cache_probe_id]]]]>3}
		DO: SetState {CACHE_APPROACH}
	IF: Always
		DO: DoAll
				SetState {CACHE_OPEN_SELECTED}
~~ }

STATE: {CACHE_APPROACH} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getunixtime[]>=getvar[tm_cache_deadline]}
