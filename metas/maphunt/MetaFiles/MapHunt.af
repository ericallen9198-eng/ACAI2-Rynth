				DoExpr {if[getvar[tm_cache_anchor]==0,setvar[tm_cache_anchor,getplayercoordinates[]]]}
				DoExpr {setpvar[mh_tm_stat_dig1,getpvar[mh_tm_stat_dig1]+1]}
				DoExpr {setvar[tm_doubloon_before,getinventorycountbytemplatetype[1004101]]}
				DoExpr {setpvar[mh_tm_dig_active,1]}
				Chat {/ub clearmotion}
				SetState {DIG_1_WAIT}
~~ }

