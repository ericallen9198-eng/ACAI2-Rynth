	IF: NavEmpty
		DO: SetState {HUNT_LOAD}
	IF: Expr {getvar[tm_resume_needed]==1 && (coordinatedistanceflat[getplayercoordinates[],getvar[tm_resume_pos]]>=30 || getunixtime[]>=getvar[tm_map_gate_until]+60)}
		DO: DoExpr {setvar[tm_resume_needed,0]}
	IF: Expr {getcharvital_current[1]>0 && maraerecoverybusy[]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getvar[tm_resume_needed]==0 && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getvar[tm_map_id]!=0}
		DO: SetState {MAP_RESUME}
	IF: Expr {getcharvital_current[1]>0 && maraerecoverybusy[]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getvar[tm_resume_needed]==0 && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getitemcountininventorybyname[`Treasure Map`]>0}
		DO: SetState {MAP_LOCK}

~~ }

STATE: {CLUE_STEP} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getpvar[meshnav]==1}
		DO: SetState {MAP_MESH_PREP}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[mh_status,`Walking a measured clue step without mesh planning`]}
				SetState {DIRECT_PREP}

~~ }

STATE: {DIRECT_PREP} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Always
		DO: DoAll
				DoExpr {setvar[tm_walk_generation,getvar[tm_walk_generation]+1]}
				DoExpr {setvar[mh_walk_token,getvar[mh_walk_token]+1]}
				DoExpr {setvar[tm_walk_ack,0]}
				SetState {DIRECT_WAIT}

~~ }

STATE: {DIRECT_WAIT} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF: Expr {coordinatedistanceflat[getplayercoordinates[],getvar[tm_step_origin]]>=getvar[tm_mesh_step]}
		DO: SetState {STEP_DONE}
	IF: Expr {getvar[tm_walk_ack]==-1}
		DO: SetState {MISSION_ERROR}
	IF: SecsInStateGE 45
		DO: SetState {MISSION_ERROR}

~~ }

STATE: {STEP_DONE} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				DoExpr {setvar[tm_mesh_failures,0]}
				SetState {MAP_RESUME}

~~ }

STATE: {DEATH_WAIT} ~~ {
	IF: All
			SecsInStateGE 6
			Expr {getcharvital_current[1]>0 && maraerecoverybusy[]==0}
		DO: SetState {DEATH_READY}

~~ }

STATE: {DEATH_READY} ~~ {
	IF: Expr {getpvar[mh_mm_pickup_unresolved]==1}
		DO: SetState {INVENTORY_REVIEW}
	IF: Always
		DO: DoAll
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_resume_needed,0]}
				DoExpr {setpvar[mh_tm_dig_active,0]}
				DoExpr {setvar[tm_map_gate_until,getunixtime[]+30]}
				SetState {HUNT_LOAD}

~~ }

STATE: {HOLD} ~~ {
	IF: Never
		DO: None
~~ }

