		DO: DoAll
				DoExpr {setvar[pt_pickup_2,1]}
				DoExpr {setvar[pt_unavailable_2,0]}
				DoExpr {setpvar[mm_180_done_2,0]}
	IF: ChatMatch {^Hea\ Talurea\ the\ Ursuin\ Hunter tells you, "(?:Slay \d+ [^"]+\. Return when the work is done\.|You have defeated \d+ of \d+ [^"]+\. The hunt is not yet finished\.)"$}
		DO: DoAll
				DoExpr {setvar[pt_pickup_3,1]}
				DoExpr {setvar[pt_unavailable_3,0]}
				DoExpr {setpvar[mm_180_done_3,0]}
	IF: ChatMatch {^Hea\ Korenuad\ the\ Golem\ Hunter tells you, "(?:Slay \d+ [^"]+\. Return when the work is done\.|You have defeated \d+ of \d+ [^"]+\. The hunt is not yet finished\.)"$}
