		DO: SetState {T275_TURNIN_START}
	IF: Expr {getvar[pt_region]==0 && ((getvar[pt_pickup_golem]==1 && getvar[pt_unavailable_golem]!=1 && getpvar[mm_275_done_golem]!=1) || (getvar[pt_pickup_siraluun]==1 && getvar[pt_unavailable_siraluun]!=1 && getpvar[mm_275_done_siraluun]!=1) || (getvar[pt_pickup_virindi]==1 && getvar[pt_unavailable_virindi]!=1 && getpvar[mm_275_done_virindi]!=1))}
		DO: SetState {T275_CAMP_EAST}
	IF: Expr {getvar[pt_region]==0 && (getvar[pt_pickup_olthoi]==1 && getvar[pt_unavailable_olthoi]!=1 && getpvar[mm_275_done_olthoi]!=1)}
