	IF: ChatMatch {^Hea\ Aroheka\ the\ Zefir\ Hunter tells you, "(?:Slay \d+ [^"]+\. Return when the work is done\.|You have defeated \d+ of \d+ [^"]+\. The hunt is not yet finished\.)"$}
		DO: DoAll
