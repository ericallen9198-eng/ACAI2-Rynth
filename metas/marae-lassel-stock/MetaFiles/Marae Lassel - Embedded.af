			Expr {getpvar[mm_275_done_siraluun]==0}
			ChatMatch {(?:^You have killed \d+ Drumtaken\ Untamed\ Siraluuns! Your task is complete!|^huntcount_plateausiraluununtamedsiraluun - 50 solves \()}
		DO: DoAll
				DoExpr {setpvar[mm_275_done_siraluun,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[ml_zone]==275}
			Expr {getpvar[mm_275_done_carenzi]==0}
			ChatMatch {(?:^You have killed \d+ Drumtaken\ Savage\ Carenzis! Your task is complete!|^huntcount_plateaucarenzisavagecarenzi - 50 solves \()}
		DO: DoAll
				DoExpr {setpvar[mm_275_done_carenzi,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[ml_zone]==275}
			Expr {getpvar[mm_275_done_virindi]==0}
			ChatMatch {(?:^You have killed \d+ Virindi\ Sentr(?:y|ies)! Your task is complete!|^huntcount_plateauvirindivirindi(?:observer|sentry) - 50 solves \()}
		DO: DoAll
				DoExpr {setpvar[mm_275_done_virindi,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[ml_zone]==275}
			Expr {getpvar[mm_275_done_olthoi]==0}
			ChatMatch {(?:^You have killed \d+ Olthoi\ Hive\ Guardians?! Your task is complete!|^huntcount_plateauolthoiolthoihive(?:mutilator|guardian) - 20 solves \()}
		DO: DoAll
				DoExpr {setpvar[mm_275_done_olthoi,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getpvar[mm_camp_limit]==1 && getvar[mm_budget_active]==1 && getvar[mm_cap_return]!=1 && getvar[pt_turnin]!=1 && getvar[ml_hunt_only]!=1 && getpvar[`mm_deadline_`+getvar[ml_zone]]>0 && getunixtime[]>=getpvar[`mm_deadline_`+getvar[ml_zone]] && getvar[tm_cache_pending]==0 && getcharvital_current[1]>0 && getvar[mm_stock_recovery_busy]==0}
		DO: SetState {BUDGET_EXPIRED}
	IF: Death
		DO: SetState {MAP_DEATH}
	IF:	Expr {getpvar[tm_dig_active]==1 && getinventorycountbytemplatetype[1004101]>getvar[tm_doubloon_before]}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_success_encounter,getpvar[tm_stat_success_encounter]+1]}
				DoExpr {echo[`Treasure Hunter: +`+(getinventorycountbytemplatetype[1004101]-getvar[tm_doubloon_before])+` Marae Lassel Doubloons (corpse)`]}
				SetState {CACHE_FINISH}
	IF:	ChatMatch {(?i)(Something buried at the dig gives way|smaller cache settles into the loose earth|The last of them falls\. Wave 8 is cleared|The last of the corruption is put down)}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_completion,getpvar[tm_stat_completion]+1]}
				DoExpr {setpvar[tm_stat_cache_search,getpvar[tm_stat_cache_search]+1]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_cache_deadline,getunixtime[]+300]}
				SetState {CACHE_PREP}
	IF: Expr {getcharvital_current[1]>0 && getvar[mm_stock_recovery_busy]==0 && getvar[tm_event_deadline]>0 && getunixtime[]>=getvar[tm_event_deadline]}
		DO: SetState {ENCOUNTER_TIMEOUT}
	IF: Expr {getcharvital_current[1]>0 && getvar[mm_stock_recovery_busy]==0 && getvar[tm_anchor_forced]==1 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_cache_anchor]]>10}
		DO: DoAll
				SetOpt {EnableNav} {False}
				Chat {/ub clearmotion}
				DoExpr {setvar[tm_anchor_failures,getvar[tm_anchor_failures]+1]}
				DoExpr {setvar[tm_anchor_retry_at,getunixtime[]+iif[getvar[tm_anchor_failures]>=3,60,15]]}
				DoExpr {setvar[ml_status,`Digsite return path not confirmed; retrying with combat yielded to navigation`]}
				SetState {DIGSITE_RETURN_RETRY}
	IF: Expr {getcharvital_current[1]>0 && getvar[mm_stock_recovery_busy]==0}
		DO: DoAll
				SetOpt {EnableNav} {False}
				Chat {/ub clearmotion}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableBuffing} {True}
				DoExpr {setvar[tm_anchor_failures,iif[coordinatedistanceflat[getplayercoordinates[],getvar[tm_cache_anchor]]<=10,0,getvar[tm_anchor_failures]+1]]}
				DoExpr {setvar[tm_anchor_retry_at,getunixtime[]+iif[getvar[tm_anchor_failures]>=3,60,15]]}
				DoExpr {setvar[tm_anchor_forced,0]}
				DoExpr {setvar[ml_status,`Dig event active; combat enabled and digsite retained`]}
				SetState {ENCOUNTER}
~~ }

