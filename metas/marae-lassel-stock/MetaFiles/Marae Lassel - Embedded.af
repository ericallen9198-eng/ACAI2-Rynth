	IF: Expr {((getvar[pt_pickup_golem]==1 && getvar[pt_unavailable_golem]!=1 && getpvar[mm_275_done_golem]!=1)==0) && ((getvar[pt_pickup_siraluun]==1 && getvar[pt_unavailable_siraluun]!=1 && getpvar[mm_275_done_siraluun]!=1)==0) && ((getvar[pt_pickup_virindi]==1 && getvar[pt_unavailable_virindi]!=1 && getpvar[mm_275_done_virindi]!=1)==0) && ((getvar[pt_pickup_olthoi]==1 && getvar[pt_unavailable_olthoi]!=1 && getpvar[mm_275_done_olthoi]!=1)==0) && ((getvar[pt_pickup_gromnie]==1 && getvar[pt_unavailable_gromnie]!=1 && getpvar[mm_275_done_gromnie]!=1)==0) && ((getvar[pt_pickup_zefir]==1 && getvar[pt_unavailable_zefir]!=1 && getpvar[mm_275_done_zefir]!=1)==0) && ((getvar[pt_pickup_ursuin]==1 && getvar[pt_unavailable_ursuin]!=1 && getpvar[mm_275_done_ursuin]!=1)==0) && ((getvar[pt_pickup_carenzi]==1 && getvar[pt_unavailable_carenzi]!=1 && getpvar[mm_275_done_carenzi]!=1)==0)}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {T275_HUNT_INIT}
	IF: Expr {getvar[pt_region]==1 && ((getvar[pt_pickup_golem]==1 && getvar[pt_unavailable_golem]!=1 && getpvar[mm_275_done_golem]!=1)==0) && ((getvar[pt_pickup_siraluun]==1 && getvar[pt_unavailable_siraluun]!=1 && getpvar[mm_275_done_siraluun]!=1)==0) && ((getvar[pt_pickup_virindi]==1 && getvar[pt_unavailable_virindi]!=1 && getpvar[mm_275_done_virindi]!=1)==0)}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {T275_HUNT_INIT}
	IF: Expr {getvar[pt_region]==2 && ((getvar[pt_pickup_olthoi]==1 && getvar[pt_unavailable_olthoi]!=1 && getpvar[mm_275_done_olthoi]!=1)==0)}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {T275_HUNT_INIT}
	IF: Expr {getvar[pt_region]==3 && ((getvar[pt_pickup_gromnie]==1 && getvar[pt_unavailable_gromnie]!=1 && getpvar[mm_275_done_gromnie]!=1)==0) && ((getvar[pt_pickup_zefir]==1 && getvar[pt_unavailable_zefir]!=1 && getpvar[mm_275_done_zefir]!=1)==0) && ((getvar[pt_pickup_ursuin]==1 && getvar[pt_unavailable_ursuin]!=1 && getpvar[mm_275_done_ursuin]!=1)==0) && ((getvar[pt_pickup_carenzi]==1 && getvar[pt_unavailable_carenzi]!=1 && getpvar[mm_275_done_carenzi]!=1)==0)}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {T275_HUNT_INIT}
	IF: Expr {getpvar[mm_camp_limit]!=1 && getunixtime[]-getvar[pt_last_progress]>=2700}
		DO: DoAll
				DoExpr {echo[`Plateau Treasure: no KT progress for 45 minutes. Check the current hunt route.`]}
				SetState {T275_DEATH_HOLD}
	IF: Expr {getunixtime[]>=getvar[pt_refresh_at]}
		DO: DoAll
				DoExpr {setvar[pt_refresh_at,getunixtime[]+120]}
				Chat {/ra quests refresh}
	IF: Expr {getvar[tm_resume_needed]==1 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_resume_pos]]>=30}
		DO: DoExpr {setvar[tm_resume_needed,0]}
	IF: Expr {getvar[ml_use_maps]==1 && getunixtime[]>=getpvar[`mm_map_retry_after_`+getvar[ml_zone]] && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getvar[tm_resume_needed]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getvar[tm_map_id]!=0 && (listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])>0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_RESUME}
	IF: Expr {getvar[tm_map_id]!=0 && (listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_MISSING}
	IF: Expr {getvar[ml_use_maps]==1 && getunixtime[]>=getpvar[`mm_map_retry_after_`+getvar[ml_zone]] && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getvar[tm_map_id]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getitemcountininventorybyname[`Treasure Map`]>0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_LOCK}
~~ }

