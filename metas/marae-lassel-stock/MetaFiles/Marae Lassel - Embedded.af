STATE: {Default} ~~ {
	IF: Expr {getvar[mm_stock_ready]!=1 || getunixtime[]-getvar[mm_stock_heartbeat]>5}
		DO: DoAll
				DoExpr {echo[`Marae: enable ACAI2.Marae in RynthCore Plugins, then Resume run.`]}
				SetState {HOLD}
	IF: Expr {getpvar[mm_pickup_unresolved]==1}
		DO: DoAll
				DoExpr {setvar[mm_schema,1]}
				DoExpr {setvar[mm_stock_schema,1]}
				SetState {INVENTORY_REVIEW}
	IF: Always
		DO: DoAll
				DoExpr {if[getpvar[pt_cache_pickup_held]==1,rasetsetting[`LootChestsMacroOff`,getpvar[pt_cache_old_pickup]]]}
				DoExpr {setpvar[pt_cache_pickup_held,0]}
				DoExpr {setvar[mm_npc_log_generation,0]}
				DoExpr {setvar[mm_budget_active,0]}
				DoExpr {setvar[mm_cap_return,0]}
				DoExpr {setvar[mm_budget_fallback,0]}
				DoExpr {setvar[mm_schema,1]}
				DoExpr {setvar[mm_stock_schema,1]}
				SetOpt {EnableNav} {False}
				SetOpt {AutoCram} {False}
				DoExpr {setvar[ml_run_mode,getpvar[ml_run_mode]]}
				DoExpr {setvar[ml_area_180,getpvar[ml_area_180]]}
				DoExpr {setvar[ml_maps_180,getpvar[ml_maps_180]]}
				DoExpr {setvar[ml_hunt_only_180,getpvar[ml_hunt_only_180]]}
				DoExpr {setvar[ml_area_225,getpvar[ml_area_225]]}
				DoExpr {setvar[ml_maps_225,getpvar[ml_maps_225]]}
				DoExpr {setvar[ml_hunt_only_225,getpvar[ml_hunt_only_225]]}
				DoExpr {setvar[ml_area_275,getpvar[ml_area_275]]}
				DoExpr {setvar[ml_maps_275,getpvar[ml_maps_275]]}
				DoExpr {setvar[ml_hunt_only_275,getpvar[ml_hunt_only_275]]}
				DoExpr {setvar[ml_zone,0]}
				DoExpr {setvar[ml_use_maps,0]}
				DoExpr {setvar[ml_done,0]}
				DoExpr {setvar[ml_cooldown,0]}
				DoExpr {setvar[ml_outcome,`Running`]}
				DoExpr {setvar[ml_status,`Choosing the next selected area`]}
				SetState {DISPATCH}
~~ }

STATE: {DISPATCH} ~~ {
	IF: Expr {getvar[ml_run_mode]!=1 && getvar[ml_run_mode]!=2}
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Setup required`]}
				DoExpr {setvar[ml_status,`Open the Marae Lassel panel and choose a mode and area.`]}
				SetState {STOP_CLEANUP}
	IF: Expr {getvar[ml_run_mode]==2 && (getvar[ml_area_180]+getvar[ml_area_225]+getvar[ml_area_275])!=1}
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Setup required`]}
				DoExpr {setvar[ml_status,`Select one treasure farming area.`]}
				SetState {STOP_CLEANUP}
	IF: Expr {getvar[ml_area_180]!=1 && getvar[ml_area_225]!=1 && getvar[ml_area_275]!=1}
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Setup required`]}
				DoExpr {setvar[ml_status,`Select at least one area.`]}
				SetState {STOP_CLEANUP}
	IF: Expr {getvar[ml_area_180]==1 && getpvar[mm_cap_pending_180]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,180]}
				DoExpr {setvar[ml_use_maps,0]}
				SetState {T180_Default}
	IF: Expr {getvar[ml_area_225]==1 && getpvar[mm_cap_pending_225]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,225]}
				DoExpr {setvar[ml_use_maps,0]}
				SetState {T225_Default}
	IF: Expr {getvar[ml_area_275]==1 && getpvar[mm_cap_pending_275]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,275]}
				DoExpr {setvar[ml_use_maps,0]}
				SetState {T275_Default}
	IF: Expr {getvar[ml_hunt_only_180]!=1 && (getpvar[mm_camp_limit]!=1 || getpvar[mm_timed_180]!=1) && getpvar[mm_area_180]!=1 && getpvar[mm_attempted_180]!=1 && getvar[ml_area_180]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,180]}
				DoExpr {setvar[ml_fship_attempted,0]}
				DoExpr {setvar[ml_use_maps,getvar[ml_run_mode]==2 || getvar[ml_maps_180]==1]}
				DoExpr {setvar[ml_status,`Traveling to camp`]}
				SetState {T180_Default}
	IF: Expr {getvar[ml_hunt_only_225]!=1 && (getpvar[mm_camp_limit]!=1 || getpvar[mm_timed_225]!=1) && getpvar[mm_area_225]!=1 && getpvar[mm_attempted_225]!=1 && getvar[ml_area_225]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,225]}
				DoExpr {setvar[ml_fship_attempted,0]}
				DoExpr {setvar[ml_use_maps,getvar[ml_run_mode]==2 || getvar[ml_maps_225]==1]}
				DoExpr {setvar[ml_status,`Traveling to camp`]}
				SetState {T225_Default}
	IF: Expr {getvar[ml_hunt_only_275]!=1 && (getpvar[mm_camp_limit]!=1 || getpvar[mm_timed_275]!=1) && getpvar[mm_area_275]!=1 && getpvar[mm_attempted_275]!=1 && getvar[ml_area_275]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,275]}
				DoExpr {setvar[ml_fship_attempted,0]}
				DoExpr {setvar[ml_use_maps,getvar[ml_run_mode]==2 || getvar[ml_maps_275]==1]}
				DoExpr {setvar[ml_status,`Traveling to camp`]}
				SetState {T275_Default}
	IF: Expr {getvar[ml_area_180]==1 && getvar[ml_hunt_only_180]==1 && getpvar[mm_hunt_cursor]<180}
		DO: DoAll
				DoExpr {setvar[ml_zone,180]}
				DoExpr {setvar[ml_use_maps,getvar[ml_maps_180]]}
				DoExpr {setvar[ml_status,`Traveling to the next continuous hunting area`]}
				SetState {T180_Default}
	IF: Expr {getvar[ml_area_225]==1 && getvar[ml_hunt_only_225]==1 && getpvar[mm_hunt_cursor]<225}
		DO: DoAll
				DoExpr {setvar[ml_zone,225]}
				DoExpr {setvar[ml_use_maps,getvar[ml_maps_225]]}
				DoExpr {setvar[ml_status,`Traveling to the next continuous hunting area`]}
				SetState {T225_Default}
	IF: Expr {getvar[ml_area_275]==1 && getvar[ml_hunt_only_275]==1 && getpvar[mm_hunt_cursor]<275}
		DO: DoAll
				DoExpr {setvar[ml_zone,275]}
				DoExpr {setvar[ml_use_maps,getvar[ml_maps_275]]}
				DoExpr {setvar[ml_status,`Traveling to the next continuous hunting area`]}
				SetState {T275_Default}
	IF: Expr {getvar[ml_area_180]==1 && getvar[ml_hunt_only_180]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,180]}
				DoExpr {setvar[ml_use_maps,getvar[ml_maps_180]]}
				DoExpr {setvar[ml_status,`Traveling to the next continuous hunting area`]}
				SetState {T180_Default}
	IF: Expr {getvar[ml_area_225]==1 && getvar[ml_hunt_only_225]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,225]}
				DoExpr {setvar[ml_use_maps,getvar[ml_maps_225]]}
				DoExpr {setvar[ml_status,`Traveling to the next continuous hunting area`]}
				SetState {T225_Default}
	IF: Expr {getvar[ml_area_275]==1 && getvar[ml_hunt_only_275]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,275]}
				DoExpr {setvar[ml_use_maps,getvar[ml_maps_275]]}
				DoExpr {setvar[ml_status,`Traveling to the next continuous hunting area`]}
				SetState {T275_Default}
	IF: Expr {((getvar[ml_area_180]!=1 || getvar[ml_hunt_only_180]==1 || getpvar[mm_area_180]==1 || getpvar[mm_attempted_180]==1 || (getpvar[mm_camp_limit]==1 && getpvar[mm_timed_180]==1)) && (getvar[ml_area_225]!=1 || getvar[ml_hunt_only_225]==1 || getpvar[mm_area_225]==1 || getpvar[mm_attempted_225]==1 || (getpvar[mm_camp_limit]==1 && getpvar[mm_timed_225]==1)) && (getvar[ml_area_275]!=1 || getvar[ml_hunt_only_275]==1 || getpvar[mm_area_275]==1 || getpvar[mm_attempted_275]==1 || (getpvar[mm_camp_limit]==1 && getpvar[mm_timed_275]==1))) && getpvar[mm_camp_limit]==1}
		DO: SetState {BUDGET_LOWLANDS}
	IF: Expr {((getvar[ml_area_180]!=1 || getvar[ml_hunt_only_180]==1 || getpvar[mm_area_180]==1 || getpvar[mm_attempted_180]==1 || (getpvar[mm_camp_limit]==1 && getpvar[mm_timed_180]==1)) && (getvar[ml_area_225]!=1 || getvar[ml_hunt_only_225]==1 || getpvar[mm_area_225]==1 || getpvar[mm_attempted_225]==1 || (getpvar[mm_camp_limit]==1 && getpvar[mm_timed_225]==1)) && (getvar[ml_area_275]!=1 || getvar[ml_hunt_only_275]==1 || getpvar[mm_area_275]==1 || getpvar[mm_attempted_275]==1 || (getpvar[mm_camp_limit]==1 && getpvar[mm_timed_275]==1))) && getpvar[mm_fallback_180]!=0}
		DO: SetState {MAP_FALLBACK_180}
	IF: Expr {getpvar[mm_attempted_180]==1 || getpvar[mm_attempted_225]==1 || getpvar[mm_attempted_275]==1}
		DO: SetState {RECOVERY_RETRY_AREAS}
	IF: Always
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Finished`]}
				DoExpr {setvar[ml_status,`Finished all selected areas.`]}
				SetState {STOP_CLEANUP}
~~ }

STATE: {AREA_DONE} ~~ {
	IF: Always
		DO: DoAll
				DoExpr {setvar[mm_budget_active,0]}
				DoExpr {setpvar[`mm_area_`+getvar[ml_zone],1]}
				DoExpr {setvar[ml_done,getvar[ml_done]+1]}
				SetState {DISPATCH}
~~ }

STATE: {AREA_COOLDOWN} ~~ {
	IF: Always
		DO: DoAll
				DoExpr {setvar[mm_budget_active,0]}
				DoExpr {setpvar[`mm_area_`+getvar[ml_zone],1]}
				DoExpr {setvar[ml_cooldown,getvar[ml_cooldown]+1]}
				SetState {DISPATCH}
~~ }

STATE: {STOP_CLEANUP} ~~ {
	IF: Always
		DO: DoAll
				DoExpr {if[getpvar[pt_cache_pickup_held]==1,rasetsetting[`LootChestsMacroOff`,getpvar[pt_cache_old_pickup]]]}
				DoExpr {setpvar[pt_cache_pickup_held,0]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {AutoCram} {False}
				SetOpt {StopMacroOnDeath} {True}
				SetOpt {OpenDoors} {False}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {uboptset[`InventoryManager.AutoCram`,false]}
				SetState {HOLD}
~~ }

STATE: {HOLD} ~~ {
	IF: Never
		DO: None
~~ }

