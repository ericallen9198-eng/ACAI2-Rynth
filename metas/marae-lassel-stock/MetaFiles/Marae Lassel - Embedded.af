				DoExpr {setvar[mm_stock_restore_generation,getvar[mm_stock_restore_generation]+1]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableLooting} {True}
				DoExpr {setpvar[`mm_map_retry_after_`+getvar[ml_zone],getunixtime[]+300]}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_resume_needed,0]}
				DoExpr {setvar[tm_cache_pending,0]}
				DoExpr {setvar[tm_cache_probe_id,0]}
				DoExpr {setvar[tm_cache_id,0]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[ml_outcome,`Running`]}
				DoExpr {setvar[ml_status,`Recovering from `+getpvar[mm_last_failure_state]+`: `+getpvar[mm_last_failure_reason]+`. Hunting continues; maps retry in five minutes.`]}
				DoExpr {echo[getvar[ml_status]]}
				SetState {RECOVERY_WAIT}
