STATE: {RUN_WAIT} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO:	SetState {MAP_MISSING}
	IF:	Expr {getvar[tm_run_length]==2 && getunixtime[]-getvar[tm_run_start]>=2}
		DO:	SetState {RUN_ACCOUNT}
	IF:	Expr {getvar[tm_run_length]==6 && getunixtime[]-getvar[tm_run_start]>=6}
		DO:	SetState {RUN_ACCOUNT}
	IF:	SecsInStateGE 12
		DO:	SetState {STUCK}
~~ }

STATE: {RUN_ACCOUNT} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Always
		DO:	DoAll
				Chat {/ub clearmotion}
				SetState {RUN_ASSESS}
~~ }

STATE: {RUN_ASSESS} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Expr {coordinatedistanceflat[getplayercoordinates[],getvar[tm_watch_pos]]>=4}
		DO:	DoAll
				DoExpr {setvar[tm_watch_pos,getplayercoordinates[]]}
				DoExpr {setvar[pt_last_move,getunixtime[]]}
				SetState {MAP_USE}
	IF:	Expr {getunixtime[]-getvar[pt_last_move]>=120}
		DO:	SetState {STUCK}
	IF:	Always
		DO:	SetState {MAP_USE}
~~ }

STATE: {STUCK} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF: Expr {getvar[pt_rerolled]==1}
		DO: SetState {SKIP_MAP}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				DoExpr {setvar[pt_retreat_from,getplayercoordinates[]]}
				Chat {/ub setmotion Backward 1}
				SetState {RETREAT_WAIT}
~~ }

STATE: {RETREAT_WAIT} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF: Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO: DoAll
				Chat {/ub clearmotion}
				SetState {MAP_MISSING}
	IF: Expr {coordinatedistanceflat[getplayercoordinates[],getvar[pt_retreat_from]]>=8}
		DO: DoAll
				Chat {/ub clearmotion}
				DoExpr {setvar[pt_rerolled,1]}
				DoExpr {echo[`180 Lowlands KT: trying /rrtm after retreat.`]}
				Chat {/rrtm}
				SetState {REROLL_WAIT}
	IF: SecsInStateGE 5
		DO: SetState {SKIP_MAP}
~~ }

STATE: {REROLL_WAIT} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF: SecsInStateGE 3
		DO: DoAll
				DoExpr {setvar[tm_watch_pos,getplayercoordinates[]]}
				DoExpr {setvar[pt_last_move,getunixtime[]]}
				SetState {MAP_RESUME}
~~ }

STATE: {MAP_COMBAT_RESUME} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[tm_resume_pos,getplayercoordinates[]]}
				DoExpr {setvar[tm_resume_needed,1]}
				DoExpr {setvar[tm_map_gate_until,getunixtime[]+60]}
				DoExpr {echo[`180 Lowlands KT: pausing the map to fight and recover.`]}
				SetState {MAP_RETURN}
~~ }

STATE: {SKIP_MAP} ~~ {
	IF: Death
		DO: SetState {MAP_DEATH}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				DoExpr {listadd[getvar[pt_skipped],getvar[tm_map_id]]}
				DoExpr {echo[`180 Lowlands KT: skipping unreachable map for this session.`]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_resume_needed,0]}
				DoExpr {setvar[tm_map_gate_until,getunixtime[]+15]}
				SetState {MAP_RETURN}
~~ }

STATE: {TEMP_HUNT} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Always
		DO:	DoAll
				Chat {/ub clearmotion}
				DoExpr {setvar[tm_resume_pos,getplayercoordinates[]]}
				DoExpr {setvar[tm_resume_needed,1]}
				SetState {MAP_RETURN}
~~ }

STATE: {DIG_FIRST} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[tm_stat_dig1,getpvar[tm_stat_dig1]+1]}
				DoExpr {setvar[tm_doubloon_before,getinventorycountbytemplatetype[1004101]]}
				DoExpr {setpvar[tm_dig_active,1]}
				Chat {/ub clearmotion}
				SetState {DIG_1_WAIT}
~~ }

STATE: {DIG_1_WAIT} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	SecsInStateGE 2
		DO:	SetState {DIG_CLICK_2}
~~ }

STATE: {DIG_CLICK_2} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO:	SetState {MAP_MISSING}
	IF:	Always
		DO:	DoAll
				DoExpr {actiontryuseitem[wobjectfindbyid[getvar[tm_map_id]]]}
				SetState {DIG_2_RESPONSE}
~~ }

STATE: {DIG_2_RESPONSE} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	ChatMatch {You dig at the site\. \(2/3\)}
		DO:	SetState {DIG_SECOND}
	IF:	ChatMatch {(?i)(The earth splits|The ground splits wide|The dig collapses inward|The dig breaks into something hollow)}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	SecsInStateGE 9
		DO:	SetState {DIG_UNCERTAIN}
~~ }

STATE: {DIG_SECOND} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[tm_stat_dig2,getpvar[tm_stat_dig2]+1]}
				DoExpr {setpvar[tm_dig_active,1]}
				Chat {/ub clearmotion}
				SetState {DIG_2_WAIT}
~~ }

STATE: {DIG_2_WAIT} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	SecsInStateGE 2
		DO:	SetState {DIG_CLICK_3}
~~ }

STATE: {DIG_CLICK_3} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO:	SetState {MAP_MISSING}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[tm_stat_dig3_attempt,getpvar[tm_stat_dig3_attempt]+1]}
				DoExpr {actiontryuseitem[wobjectfindbyid[getvar[tm_map_id]]]}
				SetState {DIG_3_RESPONSE}
~~ }

STATE: {DIG_3_RESPONSE} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	ChatMatch {(?i)(The earth splits|The ground splits wide|The dig collapses inward|The dig breaks into something hollow|\[Digsite\] (Boss at|Wave |Corrupted))}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	SecsInStateGE 15
		DO:	SetState {DIG_UNCERTAIN}
~~ }

STATE: {DIG_UNCERTAIN} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: Expr {getcharvital_current[1]*100<=getcharvital_buffedmax[1]*75}
		DO: SetState {MAP_COMBAT_RESUME}
	IF:	Expr {(listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[tm_dig_active,0]}
				SetState {TEMP_HUNT}
~~ }

STATE: {ENCOUNTER_INIT} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[tm_stat_encounter,getpvar[tm_stat_encounter]+1]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_aun_loot_active,0]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				DoExpr {setcombatstate[magic]}
				SetOpt {EnableLooting} {False}
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {ENCOUNTER}
~~ }

STATE: {ENCOUNTER} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF: All
			Expr {getvar[pt_done_zefir]==0}
			ChatMatch {(?:^You have killed 50 Drumtaken\ Enku\ Zefirs! Your task is complete!|^huntcount_plateauzefirenkuzefir - 50 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_zefir,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[pt_done_ursuin]==0}
			ChatMatch {(?:^You have killed 50 Drumtaken\ Ursuin\ Slicers! Your task is complete!|^huntcount_plateauursuinursuinslicer - 50 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_ursuin,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[pt_done_golem]==0}
			ChatMatch {(?:^You have killed 50 Drumtaken\ Verdigris\ Golems! Your task is complete!|^huntcount_plateaugolemverdigrisgolem - 50 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_golem,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[pt_done_gromnie]==0}
			ChatMatch {(?:^You have killed 50 Drumtaken\ Brass\ Gromnies! Your task is complete!|^huntcount_plateaugromniebrassgromnie - 50 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_gromnie,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[pt_done_siraluun]==0}
			ChatMatch {(?:^You have killed 50 Drumtaken\ Untamed\ Siraluuns! Your task is complete!|^huntcount_plateausiraluununtamedsiraluun - 50 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_siraluun,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[pt_done_carenzi]==0}
			ChatMatch {(?:^You have killed 50 Drumtaken\ Savage\ Carenzis! Your task is complete!|^huntcount_plateaucarenzisavagecarenzi - 50 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_carenzi,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[pt_done_virindi]==0}
			ChatMatch {(?:^You have killed 50 Virindi\ Observers! Your task is complete!|^huntcount_plateauvirindivirindiobserver - 50 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_virindi,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: All
			Expr {getvar[pt_done_olthoi]==0}
			ChatMatch {(?:^You have killed 20 Olthoi\ Hive\ Mutilators! Your task is complete!|^huntcount_plateauolthoiolthoihivemutilator - 20 solves \()}
		DO: DoAll
				DoExpr {setvar[pt_done_olthoi,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF:	Expr {getvar[tm_aun_loot_active]==0 && listcount[wobjectfindalllandscapebynamerx[`(?i)Corpse of .*Aun Relaria.*`]]>0}
		DO:	DoAll
				SetOpt {EnableLooting} {True}
				DoExpr {setvar[tm_aun_loot_active,1]}
	IF:	Expr {getvar[tm_aun_loot_active]==1 && listcount[wobjectfindalllandscapebynamerx[`(?i)Corpse of .*Aun Relaria.*`]]==0}
		DO:	DoAll
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
	IF:	Expr {getpvar[tm_dig_active]==1 && getinventorycountbytemplatetype[1004101]>getvar[tm_doubloon_before]}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_success_encounter,getpvar[tm_stat_success_encounter]+1]}
				DoExpr {echo[`Treasure Hunter: +`+(getinventorycountbytemplatetype[1004101]-getvar[tm_doubloon_before])+` Marae Lassel Doubloons (corpse)`]}
				SetState {CACHE_FINISH}
	IF:	ChatMatch {(?i)(Something buried at the dig gives way|smaller cache settles into the loose earth|The last of them falls\. Wave 8 is cleared|The last of the corruption is put down|You've earned [0-9,]+ experience)}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_completion,getpvar[tm_stat_completion]+1]}
				DoExpr {setpvar[tm_stat_cache_search,getpvar[tm_stat_cache_search]+1]}
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {EnableLooting} {False}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_cache_deadline,getunixtime[]+300]}
				SetState {CACHE_SEARCH}
	IF:	SecsInStateGE 1800
		DO:	DoAll
				DoExpr {setpvar[tm_stat_timeout_encounter,getpvar[tm_stat_timeout_encounter]+1]}
				SetState {ENCOUNTER_TIMEOUT}
~~ }

STATE: {CACHE_SEARCH} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Expr {getinventorycountbytemplatetype[1004101]>getvar[tm_doubloon_before]}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_success_search,getpvar[tm_stat_success_search]+1]}
				DoExpr {echo[`Treasure Hunter: +`+(getinventorycountbytemplatetype[1004101]-getvar[tm_doubloon_before])+` Marae Lassel Doubloons (search)`]}
				SetState {CACHE_FINISH}
	IF:	Expr {getunixtime[]>=getvar[tm_cache_deadline]}
		DO:	DoAll
				DoExpr {setpvar[tm_stat_timeout_search,getpvar[tm_stat_timeout_search]+1]}
				SetState {CACHE_FINISH}
	IF:	All
			SecsInStateGE 5
			Expr {getunixtime[]>=getvar[tm_cache_retry_at]}
		DO:	DoAll
				DoExpr {setvar[tm_cache_retry_at,getunixtime[]+8]}
				DoExpr {setpvar[tm_stat_cache_use,getpvar[tm_stat_cache_use]+1]}
				Chat {/ub use Unearthed Cache}
				SetState {CACHE_SEARCH}
~~ }

STATE: {CACHE_FINISH} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_doubloon_before,0]}
				SetState {MAP_RETURN}
~~ }

STATE: {ENCOUNTER_TIMEOUT} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	Always
		DO:	DoAll
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[tm_map_id,0]}
				SetState {MAP_RETURN}
~~ }

STATE: {MAP_MISSING} ~~ {
	IF:	Death
		DO:	SetState {MAP_DEATH}
	IF:	ChatMatch {(?i)(The earth splits|The ground splits wide|The dig collapses inward|The dig breaks into something hollow|\[Digsite\])}
		DO:	SetState {ENCOUNTER_INIT}
	IF:	SecsInStateGE 12
		DO:	DoAll
				DoExpr {setpvar[tm_stat_map_missing,getpvar[tm_stat_map_missing]+1]}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[tm_map_id,0]}
				SetState {MAP_RETURN}
~~ }
