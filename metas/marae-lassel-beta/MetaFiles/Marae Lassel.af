STATE: {Default} ~~ {
	IF: Always
		DO: DoAll
				SetOpt {EnableNav} {False}
				SetOpt {AutoCram} {False}
				DoExpr {setvar[ml_run_mode,getpvar[ml_run_mode]]}
				DoExpr {setvar[ml_area_180,getpvar[ml_area_180]]}
				DoExpr {setvar[ml_maps_180,getpvar[ml_maps_180]]}
				DoExpr {setvar[ml_area_225,getpvar[ml_area_225]]}
				DoExpr {setvar[ml_maps_225,getpvar[ml_maps_225]]}
				DoExpr {setvar[ml_area_275,getpvar[ml_area_275]]}
				DoExpr {setvar[ml_maps_275,getpvar[ml_maps_275]]}
				DoExpr {setvar[ml_zone,0]}
				DoExpr {setvar[ml_use_maps,0]}
				DoExpr {setvar[ml_done,0]}
				DoExpr {setvar[ml_cooldown,0]}
				DoExpr {setvar[ml_outcome,`Running`]}
				DoExpr {setvar[ml_status,`Choosing the next selected area`]}
				SetState {DISPATCH}
~~ }

STATE: {DISPATCH} ~~ {
	IF: Expr {getvar[ml_run_mode]!=1 && getvar[ml_run_mode]!=2}
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Setup required`]}
				DoExpr {setvar[ml_status,`Open the Marae Lassel panel and choose a mode and area.`]}
				SetState {STOP_CLEANUP}
	IF: Expr {getvar[ml_run_mode]==2 && (getvar[ml_area_180]+getvar[ml_area_225]+getvar[ml_area_275])!=1}
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Setup required`]}
				DoExpr {setvar[ml_status,`Select one treasure farming area.`]}
				SetState {STOP_CLEANUP}
	IF: Expr {getvar[ml_area_180]!=1 && getvar[ml_area_225]!=1 && getvar[ml_area_275]!=1}
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Setup required`]}
				DoExpr {setvar[ml_status,`Select at least one area.`]}
				SetState {STOP_CLEANUP}
	IF: Expr {getvar[ml_zone]<180 && getvar[ml_area_180]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,180]}
				DoExpr {setvar[ml_fship_attempted,0]}
				DoExpr {setvar[ml_use_maps,getvar[ml_run_mode]==2 || getvar[ml_maps_180]==1]}
				DoExpr {setvar[ml_status,`Traveling to camp`]}
				SetState {T180_Default}
	IF: Expr {getvar[ml_zone]<225 && getvar[ml_area_225]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,225]}
				DoExpr {setvar[ml_fship_attempted,0]}
				DoExpr {setvar[ml_use_maps,getvar[ml_run_mode]==2 || getvar[ml_maps_225]==1]}
				DoExpr {setvar[ml_status,`Traveling to camp`]}
				SetState {T225_Default}
	IF: Expr {getvar[ml_zone]<275 && getvar[ml_area_275]==1}
		DO: DoAll
				DoExpr {setvar[ml_zone,275]}
				DoExpr {setvar[ml_fship_attempted,0]}
				DoExpr {setvar[ml_use_maps,getvar[ml_run_mode]==2 || getvar[ml_maps_275]==1]}
				DoExpr {setvar[ml_status,`Traveling to camp`]}
				SetState {T275_Default}
	IF: Always
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Finished`]}
				DoExpr {setvar[ml_status,`Finished all selected areas.`]}
				SetState {STOP_CLEANUP}
~~ }

STATE: {AREA_DONE} ~~ {
	IF: Always
		DO: DoAll
				DoExpr {setvar[ml_done,getvar[ml_done]+1]}
				SetState {DISPATCH}
~~ }

STATE: {AREA_COOLDOWN} ~~ {
	IF: Always
		DO: DoAll
				DoExpr {setvar[ml_cooldown,getvar[ml_cooldown]+1]}
				SetState {DISPATCH}
~~ }

STATE: {STOP_CLEANUP} ~~ {
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {AutoCram} {False}
				SetOpt {StopMacroOnDeath} {True}
				SetOpt {OpenDoors} {False}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {uboptset[`InventoryManager.AutoCram`,false]}
				SetState {HOLD}
~~ }

STATE: {HOLD} ~~ {
	IF: Never
		DO: None
~~ }

STATE: {MAP_DEATH} ~~ {
	IF: Expr {getvar[ml_zone]==180}
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Expr {getvar[ml_zone]==225}
		DO: SetState {T225_DEATH_RECOVERY}
	IF: Expr {getvar[ml_zone]==275}
		DO: SetState {T275_DEATH_RECOVERY}
~~ }

STATE: {MAP_RETURN} ~~ {
	IF: Expr {getvar[ml_zone]==180}
		DO: SetState {T180_HUNT_RESUME}
	IF: Expr {getvar[ml_zone]==225}
		DO: SetState {T225_HUNT_RESUME}
	IF: Expr {getvar[ml_zone]==275}
		DO: SetState {T275_HUNT_RESUME}
~~ }

STATE: {T180_Default} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {StopMacroOnDeath} {False}
				SetOpt {AutoCram} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {uboptset[`InventoryManager.AutoCram`,false]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_doubloon_before,0]}
				DoExpr {setvar[tm_map_gate_until,0]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_resume_needed,0]}
				DoExpr {setvar[tm_resume_pos,0]}
				DoExpr {setvar[tm_run_length,0]}
				DoExpr {setvar[tm_run_start,0]}
				DoExpr {setvar[tm_watch_pos,0]}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[pt_skipped,listcreate[]]}
				DoExpr {setvar[pt_refresh_at,0]}
				DoExpr {setvar[pt_region,0]}
				DoExpr {setvar[pt_turnin,0]}
				DoExpr {setvar[pt_recallwest,0]}
				DoExpr {setvar[pt_death_recovered,0]}
				DoExpr {setvar[pt_recover_hunt,0]}
				DoExpr {setvar[pt_done_0,0]}
				DoExpr {setvar[pt_unavailable_0,0]}
				DoExpr {setvar[pt_done_1,0]}
				DoExpr {setvar[pt_unavailable_1,0]}
				DoExpr {setvar[pt_done_2,0]}
				DoExpr {setvar[pt_unavailable_2,0]}
				DoExpr {setvar[pt_done_3,0]}
				DoExpr {setvar[pt_unavailable_3,0]}
				DoExpr {setvar[pt_done_4,0]}
				DoExpr {setvar[pt_unavailable_4,0]}
				DoExpr {setvar[pt_done_5,0]}
				DoExpr {setvar[pt_unavailable_5,0]}
				DoExpr {setvar[pt_done_6,0]}
				DoExpr {setvar[pt_unavailable_6,0]}
				DoExpr {setvar[pt_done_7,0]}
				DoExpr {setvar[pt_unavailable_7,0]}
				DoExpr {setvar[pt_done_8,0]}
				DoExpr {setvar[pt_unavailable_8,0]}
				SetState {T180_START_LOCATION}
~~ }

STATE: {T180_START_LOCATION} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Expr {getplayerlandcell[]==347406383 && isportaling[]==0}
		DO: SetState {T180_NPC_TALK}
	IF: Always
		DO: SetState {T180_GET_TO}
~~ }

STATE: {T180_GET_TO} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {setvar[pt_get_end,0]}
				Chat {/ra nav load 180 KT - Get to}
				SetOpt {EnableNav} {True}
				SetState {T180_GET_TO_WAIT}
~~ }

STATE: {T180_GET_TO_WAIT} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: All
			ExitPortal
			Expr {getplayerlandcell[]==347406383}
		DO: DoAll
				SetOpt {EnableNav} {False}
				SetState {T180_CAMP_SETTLE}
	IF: SecsInStateGE 240
		DO: SetState {T180_ROUTE_HOLD}
~~ }

STATE: {T180_CAMP_SETTLE} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: All
			SecsInStateGE 5
			Expr {getvar[ml_run_mode]==2}
		DO: SetState {T180_FARM_LOAD}
	IF: All
			SecsInStateGE 5
			Expr {getvar[pt_turnin]==1}
		DO: SetState {T180_TURNIN_TALK}
	IF: All
			SecsInStateGE 5
			Expr {getvar[pt_recover_hunt]==1}
		DO: DoAll
				DoExpr {setvar[pt_recover_hunt,0]}
				SetState {T180_HUNT_LOAD}
	IF: SecsInStateGE 5
		DO: SetState {T180_NPC_TALK}
~~ }

STATE: {T180_NPC_TALK} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Expr {getvar[ml_run_mode]==2}
		DO: SetState {T180_FARM_LOAD}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {setvar[pt_pickup_0,0]}
				DoExpr {setvar[pt_pickup_1,0]}
				DoExpr {setvar[pt_pickup_2,0]}
				DoExpr {setvar[pt_pickup_3,0]}
				DoExpr {setvar[pt_pickup_4,0]}
				DoExpr {setvar[pt_pickup_5,0]}
				DoExpr {setvar[pt_pickup_6,0]}
				DoExpr {setvar[pt_pickup_7,0]}
				DoExpr {setvar[pt_pickup_8,0]}
				DoExpr {setvar[pt_npc_end,0]}
				Chat {/ra nav load 180 KT - Talk NPCs}
				SetOpt {EnableNav} {True}
				SetState {T180_NPC_TALK_WAIT}
~~ }

STATE: {T180_NPC_TALK_WAIT} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: ChatMatch {^Hea Tarekeh the Carenzi Hunter tells you, "(?:Slay 50 Drumtaken Carenzi Stalker\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Carenzi Stalker\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_0,1]}
	IF: ChatMatch {^Hea Tarekeh the Carenzi Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_0,1]}
				DoExpr {setvar[pt_done_0,1]}
				DoExpr {setvar[pt_unavailable_0,1]}
	IF: ChatMatch {^Hea Raukawe the Siraluun Hunter tells you, "(?:Slay 50 Drumtaken Lesser Littoral Siraluun\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Lesser Littoral Siraluun\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_1,1]}
	IF: ChatMatch {^Hea Raukawe the Siraluun Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_1,1]}
				DoExpr {setvar[pt_done_1,1]}
				DoExpr {setvar[pt_unavailable_1,1]}
	IF: ChatMatch {^Hea Teruana the Gromnie Hunter tells you, "(?:Slay 50 Drumtaken Sable Gromnie\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Sable Gromnie\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_2,1]}
	IF: ChatMatch {^Hea Teruana the Gromnie Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_2,1]}
				DoExpr {setvar[pt_done_2,1]}
				DoExpr {setvar[pt_unavailable_2,1]}
	IF: ChatMatch {^Hea Talurea the Ursuin Hunter tells you, "(?:Slay 50 Drumtaken Marae Ursuin\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Marae Ursuin\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_3,1]}
	IF: ChatMatch {^Hea Talurea the Ursuin Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_3,1]}
				DoExpr {setvar[pt_done_3,1]}
				DoExpr {setvar[pt_unavailable_3,1]}
	IF: ChatMatch {^Hea Korenuad the Golem Hunter tells you, "(?:Slay 50 Drumtaken Sand Golem\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Sand Golem\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_4,1]}
	IF: ChatMatch {^Hea Korenuad the Golem Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_4,1]}
				DoExpr {setvar[pt_done_4,1]}
				DoExpr {setvar[pt_unavailable_4,1]}
	IF: ChatMatch {^Hea Mereana the Olthoi Hunter tells you, "(?:Slay 50 Olthoi Drone\. Return when the work is done\.|You have defeated \d+ of 50 Olthoi Drone\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_5,1]}
	IF: ChatMatch {^Hea Mereana the Olthoi Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_5,1]}
				DoExpr {setvar[pt_done_5,1]}
				DoExpr {setvar[pt_unavailable_5,1]}
	IF: ChatMatch {^Hea Tuhiraki the Siberite Hunter tells you, "(?:Slay 50 Siberite Fragment\. Return when the work is done\.|You have defeated \d+ of 50 Siberite Fragment\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_6,1]}
	IF: ChatMatch {^Hea Tuhiraki the Siberite Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_6,1]}
				DoExpr {setvar[pt_done_6,1]}
				DoExpr {setvar[pt_unavailable_6,1]}
	IF: ChatMatch {^Hea Aroheka the Zefir Hunter tells you, "(?:Slay 50 Drumtaken Kirit Zefir\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Kirit Zefir\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_7,1]}
	IF: ChatMatch {^Hea Aroheka the Zefir Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_7,1]}
				DoExpr {setvar[pt_done_7,1]}
				DoExpr {setvar[pt_unavailable_7,1]}
	IF: ChatMatch {^Hea Wairena the Aun Hunter tells you, "(?:Slay 50 Aun Runner\. Return when the work is done\.|You have defeated \d+ of 50 Aun Runner\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_8,1]}
	IF: ChatMatch {^Hea Wairena the Aun Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_8,1]}
				DoExpr {setvar[pt_done_8,1]}
				DoExpr {setvar[pt_unavailable_8,1]}
	IF: Expr {getvar[pt_npc_end]==1 && getvar[pt_unavailable_0]==1 && getvar[pt_unavailable_1]==1 && getvar[pt_unavailable_2]==1 && getvar[pt_unavailable_3]==1 && getvar[pt_unavailable_4]==1 && getvar[pt_unavailable_5]==1 && getvar[pt_unavailable_6]==1 && getvar[pt_unavailable_7]==1 && getvar[pt_unavailable_8]==1}
		DO: DoAll
				DoExpr {echo[`All hunters are on cooldown or already rewarded.`]}
				SetState {AREA_COOLDOWN}
	IF: Expr {getvar[pt_npc_end]==1 && getvar[pt_pickup_0]==1 && getvar[pt_pickup_1]==1 && getvar[pt_pickup_2]==1 && getvar[pt_pickup_3]==1 && getvar[pt_pickup_4]==1 && getvar[pt_pickup_5]==1 && getvar[pt_pickup_6]==1 && getvar[pt_pickup_7]==1 && getvar[pt_pickup_8]==1}
		DO: SetState {T180_HUNT_LOAD}
	IF: SecsInStateGE 300
		DO: SetState {T180_ROUTE_HOLD}
~~ }

STATE: {T180_HUNT_LOAD} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Always
		DO: DoAll
				SetOpt {EnableNav} {False}
				DoExpr {setvar[pt_region,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
				Chat {/ra nav load 180 - Hunt Loop}
				SetState {T180_HUNT_RESUME}
~~ }

STATE: {T180_HUNT_RESUME} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableLooting} {True}
				SetOpt {EnableNav} {True}
				SetOpt {AttackDistance} {0.1291666666666667}
				SetState {T180_HUNT}
~~ }

STATE: {T180_HUNT} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Expr {getvar[ml_run_mode]==2}
		DO: SetState {T180_FARM_RUN}
	IF: Expr {getvar[ml_fship_attempted]==0 && !isportaling[] && getfellowshipcount[]>0}
		DO: DoAll
				DoExpr {setvar[ml_fship_attempted,1]}
				DoExpr {setvar[ml_fship_leave_at,getunixtime[]]}
				Chat {/fship quit}
	IF: Expr {getvar[ml_fship_attempted]<2 && !isportaling[] && getfellowshipcount[]==0}
		DO: DoAll
				DoExpr {setvar[ml_fship_attempted,2]}
				Chat {/fship joinlandblock}
	IF: Expr {getvar[ml_fship_attempted]==1 && getunixtime[]-getvar[ml_fship_leave_at]>=8}
		DO: DoExpr {setvar[ml_fship_attempted,2]}
	IF: ChatMatch {^You have killed 50 Drumtaken Carenzi Stalker(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_0,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Drumtaken Carenzi Stalker(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Drumtaken Lesser Littoral Siraluun(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_1,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Drumtaken Lesser Littoral Siraluun(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Drumtaken Sable Gromnies! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_2,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Drumtaken Sable Gromnies! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Drumtaken Marae Ursuin(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_3,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Drumtaken Marae Ursuin(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Drumtaken Sand Golem(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_4,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Drumtaken Sand Golem(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Olthoi Drone(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_5,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Olthoi Drone(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Siberite Fragment(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_6,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Siberite Fragment(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Drumtaken Kirit Zefir(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_7,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Drumtaken Kirit Zefir(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed 50 Aun Runner(?:s|es)?! Your task is complete\!}
		DO: DoAll
				DoExpr {setvar[pt_done_8,1]}
				DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: ChatMatch {^You have killed \d+ Aun Runner(?:s|es)?! You must kill 50 to complete your task\.}
		DO: DoExpr {setvar[pt_last_progress,getunixtime[]]}
	IF: Expr {getvar[pt_done_0]==1 && getvar[pt_done_1]==1 && getvar[pt_done_2]==1 && getvar[pt_done_3]==1 && getvar[pt_done_4]==1 && getvar[pt_done_5]==1 && getvar[pt_done_6]==1 && getvar[pt_done_7]==1 && getvar[pt_done_8]==1}
		DO: DoAll
				DoExpr {setvar[pt_turnin,1]}
				SetState {T180_GET_TO}
	IF: Expr {getunixtime[]-getvar[pt_last_progress]>=2700}
		DO: DoAll
				DoExpr {echo[`180 Lowlands KT: no KT progress for 45 minutes. Check the current hunt route.`]}
				SetState {T180_DEATH_HOLD}
	IF: Expr {getunixtime[]>=getvar[pt_refresh_at]}
		DO: DoAll
				DoExpr {setvar[pt_refresh_at,getunixtime[]+120]}
				Chat {/ra quests refresh}
	IF: Expr {getvar[tm_resume_needed]==1 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_resume_pos]]>=30}
		DO: DoExpr {setvar[tm_resume_needed,0]}
	IF: Expr {getvar[ml_use_maps]==1 && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getvar[tm_resume_needed]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getvar[tm_map_id]!=0 && (listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])>0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_RESUME}
	IF: Expr {getvar[tm_map_id]!=0 && (listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_MISSING}
	IF: Expr {getvar[ml_use_maps]==1 && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getvar[tm_map_id]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getitemcountininventorybyname[Treasure Map]>0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_LOCK}
~~ }

STATE: {T180_TURNIN_TALK} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {setvar[pt_npc_end,0]}
				Chat {/ra nav load 180 KT - Talk NPCs}
				SetOpt {EnableNav} {True}
				SetState {T180_TURNIN_WAIT}
~~ }

STATE: {T180_TURNIN_WAIT} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: ChatMatch {^Hea Tarekeh the Carenzi Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_0,1]}
	IF: ChatMatch {^Hea Raukawe the Siraluun Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_1,1]}
	IF: ChatMatch {^Hea Teruana the Gromnie Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_2,1]}
	IF: ChatMatch {^Hea Talurea the Ursuin Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_3,1]}
	IF: ChatMatch {^Hea Korenuad the Golem Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_4,1]}
	IF: ChatMatch {^Hea Mereana the Olthoi Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_5,1]}
	IF: ChatMatch {^Hea Tuhiraki the Siberite Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_6,1]}
	IF: ChatMatch {^Hea Aroheka the Zefir Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_7,1]}
	IF: ChatMatch {^Hea Wairena the Aun Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoExpr {setvar[pt_unavailable_8,1]}
	IF: Expr {getvar[pt_npc_end]==1 && getvar[pt_unavailable_0]==1 && getvar[pt_unavailable_1]==1 && getvar[pt_unavailable_2]==1 && getvar[pt_unavailable_3]==1 && getvar[pt_unavailable_4]==1 && getvar[pt_unavailable_5]==1 && getvar[pt_unavailable_6]==1 && getvar[pt_unavailable_7]==1 && getvar[pt_unavailable_8]==1}
		DO: DoAll
				DoExpr {echo[`All active hunt rewards confirmed.`]}
				SetState {AREA_DONE}
	IF: Expr {getvar[pt_npc_end]==1}
		DO: DoAll
				DoExpr {echo[`Turn-in finished with unconfirmed rewards. Check NPC replies.`]}
				DoExpr {setvar[ml_status,`Turn-in finished with unconfirmed rewards.`]}
				DoExpr {setvar[ml_outcome,`Needs attention`]}
				SetState {STOP_CLEANUP}
	IF: SecsInStateGE 300
		DO: SetState {T180_ROUTE_HOLD}
~~ }

STATE: {T180_DEATH_RECOVERY} ~~ {
	IF: Expr {getvar[pt_death_recovered]==1}
		DO: DoAll
				DoExpr {echo[`180 Lowlands KT: second death this run. Holding at the lifestone.`]}
				DoExpr {setvar[ml_outcome,`Needs attention`]}
				DoExpr {setvar[ml_status,`Second death in this area. The run is holding at the lifestone.`]}
				SetState {STOP_CLEANUP}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableCombat} {False}
				SetOpt {EnableLooting} {False}
				SetOpt {EnableBuffing} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {setvar[pt_death_recovered,1]}
				DoExpr {setvar[pt_recover_hunt,getvar[pt_region]>0]}
				DoExpr {setvar[pt_region,0]}
				DoExpr {setvar[pt_recallwest,0]}
				DoExpr {listadd[getvar[pt_skipped],getvar[tm_map_id]]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_resume_needed,0]}
				DoExpr {setvar[tm_resume_pos,0]}
				DoExpr {setvar[tm_map_gate_until,0]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_doubloon_before,0]}
				DoExpr {setvar[tm_run_length,0]}
				DoExpr {setvar[tm_run_start,0]}
				DoExpr {setvar[tm_watch_pos,0]}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {echo[`180 Lowlands KT: clearing the current dig and returning via 180 KT - Get to.`]}
				SetState {T180_DEATH_RETURN_WAIT}
~~ }

STATE: {T180_DEATH_RETURN_WAIT} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: All
			SecsInStateGE 5
			Expr {!isportaling[]}
			Expr {getcharvital_current[1]>0}
		DO: SetState {T180_GET_TO}
	IF: SecsInStateGE 60
		DO: SetState {T180_ROUTE_HOLD}
~~ }

STATE: {T180_ROUTE_HOLD} ~~ {
	IF: Always
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Needs attention`]}
				DoExpr {setvar[ml_status,`Travel or NPC checks timed out.`]}
				SetState {STOP_CLEANUP}
~~ }

STATE: {T180_DEATH_HOLD} ~~ {
	IF: Always
		DO: DoAll
				DoExpr {setvar[ml_outcome,`Needs attention`]}
				DoExpr {setvar[ml_status,`No KT progress for 45 minutes, or recovery limit reached.`]}
				SetState {STOP_CLEANUP}
~~ }

STATE: {T180_FARM_LOAD} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				DoExpr {setvar[pt_travel_end,0]}
				DoExpr {setvar[pt_region,1]}
				Chat {/ra nav load 180 - Treasure Circuit}
				SetState {T180_HUNT_RESUME}
~~ }

STATE: {T180_FARM_RUN} ~~ {
	IF: Death
		DO: SetState {T180_DEATH_RECOVERY}
	IF: Expr {getvar[pt_travel_end]==1}
		DO: SetState {T180_FARM_LOAD}
	IF: Expr {getvar[tm_resume_needed]==1 && coordinatedistanceflat[getplayercoordinates[],getvar[tm_resume_pos]]>=30}
		DO: DoExpr {setvar[tm_resume_needed,0]}
	IF: Expr {getvar[ml_use_maps]==1 && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getvar[tm_resume_needed]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getvar[tm_map_id]!=0 && (listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])>0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_RESUME}
	IF: Expr {getvar[tm_map_id]!=0 && (listcount[listfilter[wobjectfindallbycontainer[wobjectgetplayer[]],wobjectgetid[$1]==getvar[tm_map_id]]]+listcount[listfilter[wobjectfindallinventorybyobjectclass[10],listcount[listfilter[wobjectfindallbycontainer[$1],wobjectgetid[$1]==getvar[tm_map_id]]]>0]])==0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_MISSING}
	IF: Expr {getvar[ml_use_maps]==1 && getcharvital_current[1]*100>=getcharvital_buffedmax[1]*85 && getvar[tm_map_id]==0 && getunixtime[]>=getvar[tm_map_gate_until] && getitemcountininventorybyname[Treasure Map]>0}
		DO: DoAll
				SetOpt {AttackDistance} {0.0416666666666667}
				SetState {MAP_LOCK}
~~ }

STATE: {T225_Default} ~~ {
	IF:	Always
		DO:	DoAll
				SetOpt {StopMacroOnDeath} {False}
				SetOpt {AutoCram} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {uboptset[`InventoryManager.AutoCram`,false]}
				DoExpr {setvar[tm_cache_deadline,0]}
				DoExpr {setvar[tm_cache_retry_at,0]}
				DoExpr {setvar[tm_aun_loot_active,0]}
				DoExpr {setvar[tm_doubloon_before,0]}
				DoExpr {setvar[tm_map_gate_until,0]}
				DoExpr {setvar[tm_map_id,0]}
				DoExpr {setvar[tm_resume_needed,0]}
				DoExpr {setvar[tm_resume_pos,0]}
				DoExpr {setvar[tm_run_length,0]}
				DoExpr {setvar[tm_run_start,0]}
				DoExpr {setvar[tm_watch_pos,0]}
				DoExpr {setpvar[tm_dig_active,0]}
				DoExpr {setvar[pt_skipped,listcreate[]]}
				DoExpr {setvar[pt_refresh_at,0]}
				DoExpr {setvar[pt_region,0]}
				DoExpr {setvar[pt_turnin,0]}
				DoExpr {setvar[pt_recallwest,0]}
				DoExpr {setvar[pt_death_recovered,0]}
				DoExpr {setvar[pt_recover_hunt,0]}
				DoExpr {setvar[pt_done_0,0]}
				DoExpr {setvar[pt_unavailable_0,0]}
				DoExpr {setvar[pt_done_1,0]}
				DoExpr {setvar[pt_unavailable_1,0]}
				DoExpr {setvar[pt_done_2,0]}
				DoExpr {setvar[pt_unavailable_2,0]}
				DoExpr {setvar[pt_done_3,0]}
				DoExpr {setvar[pt_unavailable_3,0]}
				DoExpr {setvar[pt_done_4,0]}
				DoExpr {setvar[pt_unavailable_4,0]}
				DoExpr {setvar[pt_done_5,0]}
				DoExpr {setvar[pt_unavailable_5,0]}
				DoExpr {setvar[pt_done_6,0]}
				DoExpr {setvar[pt_unavailable_6,0]}
				DoExpr {setvar[pt_done_7,0]}
				DoExpr {setvar[pt_unavailable_7,0]}
				DoExpr {setvar[pt_done_8,0]}
				DoExpr {setvar[pt_unavailable_8,0]}
				DoExpr {setvar[pt_done_9,0]}
				DoExpr {setvar[pt_unavailable_9,0]}
				SetState {T225_START_LOCATION}
~~ }

STATE: {T225_START_LOCATION} ~~ {
	IF: Death
		DO: SetState {T225_DEATH_RECOVERY}
	IF: Expr {getplayerlandcell[]==465698859 && isportaling[]==0}
		DO: SetState {T225_NPC_TALK}
	IF: Always
		DO: SetState {T225_GET_TO}
~~ }

STATE: {T225_GET_TO} ~~ {
	IF: Death
		DO: SetState {T225_DEATH_RECOVERY}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {setvar[pt_get_end,0]}
				Chat {/ra nav load 225 KT - Get to}
				SetOpt {EnableNav} {True}
				SetState {T225_GET_TO_WAIT}
~~ }

STATE: {T225_CAMP_PORTAL_WAIT} ~~ {
	IF: Death
		DO: SetState {T225_DEATH_RECOVERY}
	IF: ExitPortal
		DO: DoAll
				SetOpt {EnableNav} {False}
				SetState {T225_CAMP_SETTLE}
	IF: SecsInStateGE 60
		DO: SetState {T225_ROUTE_HOLD}
~~ }

STATE: {T225_GET_TO_WAIT} ~~ {
	IF: Death
		DO: SetState {T225_DEATH_RECOVERY}
	IF: ChatMatch {(?i)^Using the Northern Hunters' Camp}
		DO: SetState {T225_CAMP_PORTAL_WAIT}
	IF: SecsInStateGE 240
		DO: SetState {T225_ROUTE_HOLD}
~~ }

STATE: {T225_CAMP_SETTLE} ~~ {
	IF: Death
		DO: SetState {T225_DEATH_RECOVERY}
	IF: All
			SecsInStateGE 5
			Expr {getvar[ml_run_mode]==2}
		DO: SetState {T225_FARM_LOAD}
	IF: All
			SecsInStateGE 5
			Expr {getvar[pt_turnin]==1}
		DO: SetState {T225_TURNIN_TALK}
	IF: All
			SecsInStateGE 5
			Expr {getvar[pt_recover_hunt]==1}
		DO: DoAll
				DoExpr {setvar[pt_recover_hunt,0]}
				SetState {T225_HUNT_LOAD}
	IF: SecsInStateGE 5
		DO: SetState {T225_NPC_TALK}
~~ }

STATE: {T225_NPC_TALK} ~~ {
	IF: Death
		DO: SetState {T225_DEATH_RECOVERY}
	IF: Expr {getvar[ml_run_mode]==2}
		DO: SetState {T225_FARM_LOAD}
	IF: Always
		DO: DoAll
				Chat {/ub clearmotion}
				SetOpt {EnableNav} {False}
				SetOpt {EnableBuffing} {True}
				SetOpt {EnableCombat} {True}
				SetOpt {EnableLooting} {False}
				SetOpt {AttackDistance} {0.0208333333333333}
				DoExpr {setvar[pt_pickup_0,0]}
				DoExpr {setvar[pt_pickup_1,0]}
				DoExpr {setvar[pt_pickup_2,0]}
				DoExpr {setvar[pt_pickup_3,0]}
				DoExpr {setvar[pt_pickup_4,0]}
				DoExpr {setvar[pt_pickup_5,0]}
				DoExpr {setvar[pt_pickup_6,0]}
				DoExpr {setvar[pt_pickup_7,0]}
				DoExpr {setvar[pt_pickup_8,0]}
				DoExpr {setvar[pt_pickup_9,0]}
				DoExpr {setvar[pt_npc_end,0]}
				Chat {/ra nav load 225 KT - Talk NPCs}
				SetOpt {EnableNav} {True}
				SetState {T225_NPC_TALK_WAIT}
~~ }

STATE: {T225_NPC_TALK_WAIT} ~~ {
	IF: Death
		DO: SetState {T225_DEATH_RECOVERY}
	IF: ChatMatch {^Hea Narekua the Ursuin Hunter tells you, "(?:Slay 50 Drumtaken Woodland Ursuin\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Woodland Ursuin\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_0,1]}
	IF: ChatMatch {^Hea Narekua the Ursuin Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_0,1]}
				DoExpr {setvar[pt_done_0,1]}
				DoExpr {setvar[pt_unavailable_0,1]}
	IF: ChatMatch {^Hea Hineroa the Golem Hunter tells you, "(?:Slay 50 Drumtaken Elariwood Golem\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Elariwood Golem\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_1,1]}
	IF: ChatMatch {^Hea Hineroa the Golem Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_1,1]}
				DoExpr {setvar[pt_done_1,1]}
				DoExpr {setvar[pt_unavailable_1,1]}
	IF: ChatMatch {^Hea Orewhiti the Zefir Hunter tells you, "(?:Slay 50 Drumtaken Azael Zefir\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Azael Zefir\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_2,1]}
	IF: ChatMatch {^Hea Orewhiti the Zefir Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_2,1]}
				DoExpr {setvar[pt_done_2,1]}
				DoExpr {setvar[pt_unavailable_2,1]}
	IF: ChatMatch {^Hea Pukerua the Gromnie Hunter tells you, "(?:Slay 50 Drumtaken Copper Gromnie\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Copper Gromnie\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_3,1]}
	IF: ChatMatch {^Hea Pukerua the Gromnie Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_3,1]}
				DoExpr {setvar[pt_done_3,1]}
				DoExpr {setvar[pt_unavailable_3,1]}
	IF: ChatMatch {^Hea Kahureka the Siraluun Hunter tells you, "(?:Slay 50 Drumtaken Kithless Siraluun\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Kithless Siraluun\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_4,1]}
	IF: ChatMatch {^Hea Kahureka the Siraluun Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_4,1]}
				DoExpr {setvar[pt_done_4,1]}
				DoExpr {setvar[pt_unavailable_4,1]}
	IF: ChatMatch {^Hea Marenua the Carenzi Hunter tells you, "(?:Slay 50 Drumtaken Rabid Carenzi\. Return when the work is done\.|You have defeated \d+ of 50 Drumtaken Rabid Carenzi\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_5,1]}
	IF: ChatMatch {^Hea Marenua the Carenzi Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_5,1]}
				DoExpr {setvar[pt_done_5,1]}
				DoExpr {setvar[pt_unavailable_5,1]}
	IF: ChatMatch {^Hea Zanuah the Siberite Hunter tells you, "(?:Slay 50 Siberite Shard\. Return when the work is done\.|You have defeated \d+ of 50 Siberite Shard\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_6,1]}
	IF: ChatMatch {^Hea Zanuah the Siberite Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
				DoExpr {setvar[pt_pickup_6,1]}
				DoExpr {setvar[pt_done_6,1]}
				DoExpr {setvar[pt_unavailable_6,1]}
	IF: ChatMatch {^Hea Tamaneru the Aun Hunter tells you, "(?:Slay 50 Aun Shaman\. Return when the work is done\.|You have defeated \d+ of 50 Aun Shaman\.[^"]*)"}
		DO: DoExpr {setvar[pt_pickup_7,1]}
	IF: ChatMatch {^Hea Tamaneru the Aun Hunter tells you, "(?:Your hunt for today is done\. You may take another hunt in [^"]+|Return in [^"]+ for another hunt\.|You have served the Hea well\. Accept this reward for your efforts\.)"}
		DO: DoAll
