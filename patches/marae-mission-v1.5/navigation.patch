+    // Mission-owned temporary walks keep the original hunt route object/index intact.
+    private NavRouteParser? _maraeSavedRoute;
+    private string _maraeSavedPath = "";
+    private NavRouteParser? _maraeTemporaryRoute;
+    private int _maraeSavedIndex;
+    private float _maraeSavedReach;
+    private uint _maraeSavedPlayer;
+    private bool _maraeHasSavedNav;
+    private string EvalMaraeNavSave()
+    {
+        uint player = _host.GetPlayerId();
+        if (_settings == null || !_settings.IsMacroRunning || player == 0) return "0";
+        if (_maraeHasSavedNav && _maraeSavedPlayer == player) return "1";
+        _maraeSavedRoute = _settings.CurrentRoute;
+        _maraeSavedPath = _settings.CurrentNavPath;
+        _maraeSavedIndex = _settings.ActiveNavIndex;
+        _maraeSavedReach = _settings.FollowNavMin;
+        _maraeSavedPlayer = player;
+        _maraeHasSavedNav = true;
+        return "1";
+    }
+    private string EvalMaraeNavMark()
+    {
+        if (!_maraeHasSavedNav || _settings == null || _host.GetPlayerId() != _maraeSavedPlayer) return "0";
+        _maraeTemporaryRoute = _settings.CurrentRoute;
+        _settings.FollowNavMin = 0.5f;
+        if (_maraeTemporaryRoute?.Points.Count == 1) _maraeTemporaryRoute.Points[0].Doorway = true;
+        return "1";
+    }
+    private string EvalMaraeNavRestore()
+    {
+        if (!_maraeHasSavedNav) return "0";
+        bool samePlayer = _settings != null && _host.GetPlayerId() == _maraeSavedPlayer;
+        if (samePlayer && ReferenceEquals(_settings!.CurrentRoute, _maraeTemporaryRoute))
+        {
+            _settings!.EnableNavigation = false;
+            _settings.CurrentRoute = _maraeSavedRoute;
+            _settings.CurrentNavPath = _maraeSavedPath;
+            _settings.ActiveNavIndex = _maraeSavedIndex;
+        }
+        if (samePlayer && _settings!.FollowNavMin == 0.5f) _settings.FollowNavMin = _maraeSavedReach;
+        _maraeHasSavedNav = false;
+        _maraeSavedRoute = null;
+        _maraeTemporaryRoute = null;
+        _maraeSavedPath = "";
+        return samePlayer ? "1" : "0";
+    }
 
