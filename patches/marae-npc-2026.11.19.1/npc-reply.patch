     /// Uses CastSpell directly because WriteToChat("/rs N") only *displays* text;
     /// it does not route through the chat parser.
     /// </summary>
+    private void HandleConfirmedNpc(NavPoint pt, NavRouteParser route, int idx)
+    {
+        _npcReply.Bind(route, idx, pt.TargetName.Trim());
+        if (_npcReply.HasReply)
+        {
+            StopMovement();
+            _host.Log($"Nav: hunter reply confirmed [{idx}] '{pt.TargetName}' - advancing");
+            Advance(route);
+            return;
+        }
+        if (_npcReply.Waiting(route, idx))
+        {
+            _settings.NavStatusLine = $"Nav: waiting for '{pt.TargetName}' reply...";
+            if (!_npcReply.Due(Now)) return;
+        }
+        else
+        {
+            if (!TryGetPos(out double ns, out double ew)) return;
+            double distance = Math.Sqrt(Sq(pt.NS - ns) + Sq(pt.EW - ew)) * 240.0;
+            if (distance >= ArrivalYards)
+            {
+                SteerToWaypoint(idx, pt, route, ns, ew, distance);
+                return; // reaching coordinates alone never completes this waypoint
+            }
+            if (!_npcReply.Due(Now)) return;
+            StopMovement();
+        }
+
+        int player = unchecked((int)(_playerId != 0 ? _playerId : (uint)_host.GetPlayerId()));
+        int target = 0;
+        double nearest = 30.0;
+        if (_objectCache != null && player != 0 && _host.HasUseObject)
+        {
+            foreach (var obj in _objectCache.GetLandscapeObjects())
+            {
+                // Exact name, not a substring; cache class can differ from a recorded VTank class.
+                var current = _objectCache[obj.Id] ?? obj;
+                if (!string.Equals(current.Name, pt.TargetName.Trim(), StringComparison.OrdinalIgnoreCase)) continue;
+                double distance = _objectCache.Distance(player, obj.Id);
+                if (double.IsFinite(distance) && distance >= 0 && distance < nearest)
+                { nearest = distance; target = obj.Id; }
+            }
+        }
+        if (target == 0)
+        {
+            _npcReply.NoUse(Now);
+            _settings.NavStatusLine = $"Nav: finding hunter '{pt.TargetName}' (retrying)...";
+            return;
+        }
+        _npcReply.BeginUse(Now);
+        if (!_host.UseFor((uint)target, "Nav", $"confirmed NPC waypoint '{pt.TargetName}'"))
+        {
+            _npcReply.NoUse(Now);
+            return;
+        }
+        _settings.NavStatusLine = $"Nav: waiting for '{pt.TargetName}' reply...";
+        _host.Log($"Nav: talk [{idx}] '{pt.TargetName}' 0x{target:X8}; awaiting reply (8s retry)");
+    }
