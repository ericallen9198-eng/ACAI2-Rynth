# Preserve the exact reviewed nav and VTank meta bytes in the downloadable package.
metas/plateau-treasure-verified-v1/*.nav -text whitespace=cr-at-eol
metas/plateau-treasure-verified-v1/*.met -text whitespace=cr-at-eol
metas/plateau-treasure-verified-v2/*.nav -text whitespace=cr-at-eol
metas/plateau-treasure-verified-v2/*.met -text whitespace=cr-at-eol
metas/plateau-treasure-verified-v3/*.nav -text whitespace=cr-at-eol
metas/plateau-treasure-verified-v3/*.met -text whitespace=cr-at-eol

# Preserve Soot's uploaded beta bytes in release packaging on Windows too.
metas/marae-lassel-beta/** -text whitespace=cr-at-eol

# A patch contains significant single-space context lines.
patches/**/*.patch -text whitespace=-blank-at-eol
