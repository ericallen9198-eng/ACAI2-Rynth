STATE: {Default} ~~ {
	IF: Expr {getvar[te_logger_schema]!=3 || getvar[te_logger_active]!=1 || getunixtime[]-getvar[te_logger_heartbeat]>20}
		DO: DoAll
				SetState {LOGGER_LOST}
	IF: Death
		DO: DoAll
				SetState {RECOVERY_WAIT}
	IF: Expr {getvar[te_recovery_busy]==1}
		DO: DoAll
				SetState {RECOVERY_WAIT}
	IF: Expr {ragetsetting[FollowNavMin]>0.75 || ragetsetting[NavResumeNearest]!=0}
		DO: DoAll
				DoExpr {echo[`Terrain survey needs FollowNavMin=0.5 and NavResumeNearest=0 before starting. See READ FIRST.`]}
				SetState {FINISH}
	IF: Always
		DO: DoAll
				DoExpr {setvar[te_stage,0]}
				DoExpr {setvar[te_probe,1]}
				DoExpr {setvar[te_attempt,0]}
				DoExpr {setvar[te_entry_hub,1]}
				DoExpr {setvar[te_recall_attempts,0]}
				DoExpr {echo[`Terrain Access Survey: fresh mesh-planned cliff approaches, no hunt loops. Probe results are provisional.`]}
				SetState {RECALL}
~~ }

