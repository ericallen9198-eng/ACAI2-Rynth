				DoExpr {setvar[te_transport_timeout,0]}
				DoExpr {setvar[te_recall_attempts,getvar[te_recall_attempts]+1]}
				DoExpr {setvar[te_settle,getunixtime[]+5]}
				DoExpr {echo[`[TerrainSurvey] Hub recall: `+getvar[te_return_reason]+`; last movement result: `+getvar[te_reason]]}
				Chat {/ls}
				SetState {HUB_WAIT}
~~ }

