<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RynthSuiteRoot Condition="'$(RynthSuiteRoot)' == ''">/tmp/terrain-suite-latest</RynthSuiteRoot>
  </PropertyGroup>
  <ItemGroup>



    <Compile Include="$(RynthSuiteRoot)/Plugins/RynthCore.Plugin.RynthAi/Meta/AfFileParser.cs" Link="AfFileParser.cs" />
    <Compile Include="$(RynthSuiteRoot)/Plugins/RynthCore.Plugin.RynthAi/Meta/MetFileParser.cs" Link="MetFileParser.cs" />
    <Compile Include="$(RynthSuiteRoot)/Plugins/RynthCore.Plugin.RynthAi/Meta/MetaSchema.cs" Link="MetaSchema.cs" />
    <Compile Include="$(RynthSuiteRoot)/Plugins/RynthCore.Plugin.RynthAi/Meta/LoadedMeta.cs" Link="LoadedMeta.cs" />
    <Compile Include="$(RynthSuiteRoot)/Plugins/RynthCore.Plugin.RynthAi/Meta/EmbedNavName.cs" Link="EmbedNavName.cs" />
    <Compile Include="$(RynthSuiteRoot)/Plugins/RynthCore.Plugin.RynthAi/LegacyUi/NavRouteParser.cs" Link="NavRouteParser.cs" />
    <Compile Include="$(IntermediateOutputPath)ParserTypes.g.cs" />
    <ProjectReference Include="$(RynthSuiteRoot)/Shared/RynthCore.LootSdk/RynthCore.LootSdk.csproj" />
  </ItemGroup>
  <Target Name="ExtractUnmodifiedParserTypes" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../../ACAI2.MaraeMission/generate_types.py&quot; &quot;$(RynthSuiteRoot)&quot; &quot;$(IntermediateOutputPath)ParserTypes.g.cs&quot;" />
  </Target>
</Project>
