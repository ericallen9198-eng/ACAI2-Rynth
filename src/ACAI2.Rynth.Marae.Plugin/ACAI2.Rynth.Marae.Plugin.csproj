<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <Version>1.18.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <AssemblyName>ACAI2.Rynth.Marae.Plugin</AssemblyName>
    <RynthPluginName>ACAI2.Marae</RynthPluginName>
    <RynthPluginMinEngineApi>92</RynthPluginMinEngineApi>
    <RynthPluginDescription>Marae Lassel tasks, hunting and treasure maps with the normal RynthAi DLL.</RynthPluginDescription>
  </PropertyGroup>
  <ItemGroup>
    <RynthPluginDependency Include="RynthAi" />
    <RynthPluginDependency Include="RynthNav" Optional="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" ExcludeAssets="runtime" />
    <ProjectReference Include="..\ACAI2.Rynth.Marae.Core\ACAI2.Rynth.Marae.Core.csproj" />
    <ProjectReference Include="..\..\external\RynthCore\src\RynthCore.PluginSdk\RynthCore.PluginSdk.csproj" />
    <ProjectReference Include="..\..\external\RynthCore\src\RynthCore.PluginCore\RynthCore.PluginCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="hunters.json" LogicalName="Marae.hunters.json" />
    <EmbeddedResource Include="../../metas/marae-lassel-stock/MetaFiles/Marae Lassel - Embedded.af" LogicalName="Marae.workflow.af" />
    <EmbeddedResource Include="../../metas/marae-lassel-mission/checkpoint-keys.json" LogicalName="Marae.keys.json" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/ToolbarWindow.cs" Link="Ui/ToolbarWindow.cs" /></ItemGroup>
  <Import Project="..\..\external\RynthCore\src\RynthCore.PluginSdk\build\RynthCore.PluginSdk.targets" />
  <!-- The SDK import runs before IntermediateOutputPath is populated. Keep its
       generated sources under obj so subsequent builds do not glob them twice. -->
  <PropertyGroup>
    <_RynthPluginManifestJson>obj/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/rynth-plugin.json</_RynthPluginManifestJson>
    <_RynthPluginManifestEmbedded>obj/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/rynth-plugin.embedded</_RynthPluginManifestEmbedded>
    <_RynthPluginInfoSource>obj/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/RynthPluginInfo.g.cs</_RynthPluginInfoSource>
  </PropertyGroup>
</Project>
